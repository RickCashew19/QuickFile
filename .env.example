PORT=3000
NODE_ENV=development
JWT_SECRET=quickfile_secret_barangay_key_2026_super_secure
SESSION_SECRET=quickfile_session_barangay_secret_phrase_2026
DB_PATH=./src/database/quickfile.db

# ========================================================
# 1. DEVELOPER DEFAULT PRESETS (Out-of-the-box System Defaults)
# ========================================================
DEFAULT_SMTP_HOST=smtp.gmail.com
DEFAULT_SMTP_PORT=465
DEFAULT_SMTP_SECURE=true
DEFAULT_SMTP_USER=your_dev_email@gmail.com
DEFAULT_SMTP_PASS=your_16_char_app_password
DEFAULT_SMTP_FROM="QuickFile Barangay Central (Default)" <your_dev_email@gmail.com>

DEFAULT_GOOGLE_CLIENT_ID=your-default-client-id.apps.googleusercontent.com
DEFAULT_GOOGLE_CLIENT_SECRET=your_default_client_secret

DEFAULT_SMS_PROVIDER=PhilSMS
DEFAULT_SMS_API_ENDPOINT=https://dashboard.philsms.com/api/v3/
DEFAULT_SMS_API_KEY=your_default_sms_key
DEFAULT_SMS_SENDER_ID=PhilSMS

DEFAULT_API_SECRET_KEY=qf_developer_default_secret_key

# ========================================================
# 2. CLIENT CUSTOM OVERRIDES (Can also be set in Web UI)
# ========================================================
CUSTOM_SMTP_HOST=
CUSTOM_SMTP_PORT=465
CUSTOM_SMTP_SECURE=true
CUSTOM_SMTP_USER=
CUSTOM_SMTP_PASS=
CUSTOM_SMTP_FROM=

CUSTOM_GOOGLE_CLIENT_ID=
CUSTOM_GOOGLE_CLIENT_SECRET=

CUSTOM_SMS_PROVIDER=
CUSTOM_SMS_API_ENDPOINT=
CUSTOM_SMS_API_KEY=
CUSTOM_SMS_SENDER_ID=

CUSTOM_API_SECRET_KEY=

# Backward Compatibility
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="QuickFile Barangay Central" <your_email@gmail.com>
