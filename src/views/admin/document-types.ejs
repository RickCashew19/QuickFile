<%- include('../layouts/header', { title: 'Document Type & Requirement Management (ADM-DTM) - QuickFile' }) %>

<div class="row g-4 mb-4">
  <div class="col-12">
    <div class="card card-custom p-4 bg-dark text-white border-0 shadow">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-semibold mb-2">
            ADM-DTM &bull; Barangay Document Catalog Configuration
          </span>
          <h2 class="fw-bold mb-1">Document Types & Requirements</h2>
          <p class="mb-0 text-white-50">
            Define official certificate types, regulatory fees, processing turnaround, and prerequisite requirements.
          </p>
        </div>
        <div>
          <button type="button" class="btn btn-warning rounded-pill fw-semibold text-dark px-4" data-bs-toggle="modal" data-bs-target="#addDocModal">
            <i class="bi bi-plus-circle-fill me-1"></i> Add Document Type (ADM-DTM-01)
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Document Types Table -->
<div class="row g-4 mb-4">
  <div class="col-12">
    <div class="card card-custom p-4 shadow-sm">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h5 class="fw-bold mb-1">Official Document Catalog (<%= docTypes ? docTypes.length : 0 %> Types)</h5>
          <span class="text-muted small">Citizens select from active types when applying online (CIT-DCR-01).</span>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Code</th>
              <th>Document Name</th>
              <th>Description</th>
              <th class="text-center">Fee</th>
              <th class="text-center">Turnaround</th>
              <th>Prerequisites / Requirements (CIT-DCR-02)</th>
              <th class="text-center">Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (docTypes && docTypes.length > 0) { %>
              <% docTypes.forEach(function(doc) { %>
                <tr>
                  <td><code><%= doc.code %></code></td>
                  <td class="fw-bold">
                    <%= doc.name %>
                    <small class="text-muted d-block fw-normal"><i class="bi bi-clock-history me-1"></i>Updated: <%= formatDateTime(doc.updated_at || doc.created_at) %></small>
                  </td>
                  <td class="small text-muted" style="max-width: 240px;"><%= doc.description %></td>
                  <td class="text-center">
                    <% if (doc.fee > 0) { %>
                      <span class="badge bg-light text-dark border">₱<%= doc.fee.toFixed(2) %></span>
                    <% } else { %>
                      <span class="badge bg-success-subtle text-success">FREE</span>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <span class="badge bg-secondary-subtle text-dark"><%= doc.processing_days %> Day<%= doc.processing_days > 1 ? 's' : '' %></span>
                  </td>
                  <td class="small" style="max-width: 250px;">
                    <ul class="mb-0 ps-3">
                      <% (doc.requirements_text || '').split('\n').filter(r => r.trim()).forEach(function(r) { %>
                        <li><%= r.replace(/^[•\-\*]\s*/, '') %></li>
                      <% }); %>
                    </ul>
                  </td>
                  <td class="text-center">
                    <% if (doc.is_active) { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                    <% } else { %>
                      <span class="badge bg-secondary-subtle text-secondary border">Inactive</span>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <div class="d-flex justify-content-end gap-1">
                      <!-- Edit Modal Trigger (ADM-DTM-02) -->
                      <button type="button" class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#editModal-<%= doc.id %>">
                        <i class="bi bi-pencil-fill me-1"></i> Edit
                      </button>

                      <!-- Delete Form (ADM-DTM-03) -->
                      <form action="/admin/document-types/<%= doc.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete <%= doc.name %>? If requests exist, please deactivate instead.');" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                          <i class="bi bi-trash-fill"></i>
                        </button>
                      </form>
                    </div>

                    <!-- Edit Modal (ADM-DTM-02) -->
                    <div class="modal fade" id="editModal-<%= doc.id %>" tabindex="-1" aria-hidden="true">
                      <div class="modal-dialog modal-lg text-start">
                        <div class="modal-content">
                          <form action="/admin/document-types/<%= doc.id %>/update" method="POST">
                            <div class="modal-header">
                              <h5 class="modal-title fw-bold">Edit Document Type (ADM-DTM-02)</h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                              <div class="row g-3">
                                <div class="col-md-4">
                                  <label class="form-label fw-semibold">Document Code</label>
                                  <input type="text" class="form-control" value="<%= doc.code %>" disabled>
                                  <small class="text-muted">Unique code cannot be changed.</small>
                                </div>
                                <div class="col-md-8">
                                  <label class="form-label fw-semibold">Document Name *</label>
                                  <input type="text" name="name" class="form-control" value="<%= doc.name %>" required>
                                </div>
                                <div class="col-12">
                                  <label class="form-label fw-semibold">Description</label>
                                  <textarea name="description" class="form-control" rows="2"><%= doc.description %></textarea>
                                </div>
                                <div class="col-md-6">
                                  <label class="form-label fw-semibold">Issuance Fee (₱)</label>
                                  <input type="number" step="0.01" name="fee" class="form-control" value="<%= doc.fee %>" required>
                                </div>
                                <div class="col-md-6">
                                  <label class="form-label fw-semibold">Standard Processing Days</label>
                                  <input type="number" name="processingDays" class="form-control" value="<%= doc.processing_days %>" required min="1">
                                </div>
                                <div class="col-12">
                                  <label class="form-label fw-semibold">Prerequisite Requirements (CIT-DCR-02)</label>
                                  <textarea name="requirementsText" class="form-control" rows="4"><%= doc.requirements_text %></textarea>
                                  <small class="text-muted">Enter each required document or ID on a separate line.</small>
                                </div>
                                <div class="col-12">
                                  <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" name="isActive" value="1" id="active-<%= doc.id %>" <%= doc.is_active ? 'checked' : '' %>>
                                    <label class="form-check-label fw-semibold" for="active-<%= doc.id %>">Available in Citizen Request Catalog</label>
                                  </div>
                                </div>
                              </div>
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-primary rounded-pill px-4">Save Changes</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>

                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center text-muted py-4">No document types configured. Add one below.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Add New Document Type (ADM-DTM-01) -->
<div class="modal fade" id="addDocModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form action="/admin/document-types" method="POST">
        <div class="modal-header">
          <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-plus me-2 text-warning"></i>Add Document Type (ADM-DTM-01)</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label fw-semibold">Code / Identifier *</label>
              <input type="text" name="code" class="form-control text-uppercase" placeholder="e.g. TAX_CLEARANCE" required>
              <small class="text-muted">Alphanumeric unique identifier.</small>
            </div>
            <div class="col-md-8">
              <label class="form-label fw-semibold">Official Document Name *</label>
              <input type="text" name="name" class="form-control" placeholder="e.g. Barangay Tax Clearance" required>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Description / Purpose</label>
              <textarea name="description" class="form-control" rows="2" placeholder="Explain the legal or administrative purpose of this document..."></textarea>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Standard Fee (₱) *</label>
              <input type="number" step="0.01" name="fee" class="form-control" value="0.00" required>
              <small class="text-muted">Enter 0 for free certificates (e.g. Indigency).</small>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Standard Processing Days *</label>
              <input type="number" name="processingDays" class="form-control" value="1" min="1" required>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Prerequisite Requirements (CIT-DCR-02) *</label>
              <textarea name="requirementsText" class="form-control" rows="4" placeholder="Valid Government ID&#10;Proof of Billing&#10;Community Tax Certificate (Cedula)" required></textarea>
              <small class="text-muted">List each required prerequisite document on its own line.</small>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold text-dark">Add Document Type</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

