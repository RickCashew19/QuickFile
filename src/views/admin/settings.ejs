<script>
  // Dynamic Tab / Radio Toggling for SMTP
  document.querySelectorAll('input[name="smtp_source_radio"]').forEach(radio => {
    radio.addEventListener('change', (e) => {
      const isCustom = e.target.value === 'custom';
      document.getElementById('smtpDefaultSection').classList.toggle('d-none', isCustom);
      document.getElementById('smtpCustomSection').classList.toggle('d-none', !isCustom);
    });
  });

  // Dynamic Tab / Radio Toggling for Google
  document.querySelectorAll('input[name="google_source_radio"]').forEach(radio => {
    radio.addEventListener('change', (e) => {
      const isCustom = e.target.value === 'custom';
      document.getElementById('googleDefaultSection').classList.toggle('d-none', isCustom);
      document.getElementById('googleCustomSection').classList.toggle('d-none', !isCustom);
    });
  });

  // Dynamic Tab / Radio Toggling for REST API
  document.querySelectorAll('input[name="api_source_radio"]').forEach(radio => {
    radio.addEventListener('change', (e) => {
      const isCustom = e.target.value === 'custom';
      document.getElementById('apiDefaultSection').classList.toggle('d-none', isCustom);
      document.getElementById('apiCustomSection').classList.toggle('d-none', !isCustom);
    });
  });

  // Dynamic Tab / Radio Toggling for SMS
  document.querySelectorAll('input[name="sms_source_radio"]').forEach(radio => {
    radio.addEventListener('change', (e) => {
      const isCustom = e.target.value === 'custom';
      document.getElementById('smsDefaultSection').classList.toggle('d-none', isCustom);
      document.getElementById('smsCustomSection').classList.toggle('d-none', !isCustom);
    });
  });

  // Generator for REST API Secret Key
  document.getElementById('btnGenApiKey')?.addEventListener('click', () => {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    let key = 'qf_live_sec_';
    for (let i = 0; i < 32; i++) {
      key += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    document.getElementById('modal_custom_api_secret_key').value = key;
  });

  // Test SMTP Connection Button inside Modal
  document.getElementById('btnTestSmtpConnection')?.addEventListener('click', async () => {
    const btn = document.getElementById('btnTestSmtpConnection');
    const spinner = document.getElementById('spinnerTestSmtp');
    const alertBox = document.getElementById('smtpTestAlert');

    const source = document.querySelector('input[name="smtp_source_radio"]:checked').value;
    const payload = {
      source: source
    };

    if (source === 'custom') {
      payload.host = document.getElementById('modal_custom_smtp_host').value;
      payload.port = document.getElementById('modal_custom_smtp_port').value;
      payload.secure = document.getElementById('modal_custom_smtp_secure').checked;
      payload.user = document.getElementById('modal_custom_smtp_user').value;
      payload.pass = document.getElementById('modal_custom_smtp_pass').value;
    }

    btn.disabled = true;
    spinner.classList.remove('d-none');
    alertBox.className = 'alert alert-info py-2 px-3 small mb-0';
    alertBox.textContent = 'Testing SMTP connection to server...';
    alertBox.classList.remove('d-none');

    try {
      const res = await fetch('/admin/settings/test-smtp-connection', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (data.success) {
        alertBox.className = 'alert alert-success py-2 px-3 small mb-0';
        alertBox.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> ' + data.message;
      } else {
        alertBox.className = 'alert alert-danger py-2 px-3 small mb-0';
        alertBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Error: ' + (data.message || 'Connection failed.');
      }
    } catch (err) {
      alertBox.className = 'alert alert-danger py-2 px-3 small mb-0';
      alertBox.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Network error: ' + err.message;
    } finally {
      btn.disabled = false;
      spinner.classList.add('d-none');
    }
  });

  // Modal Apply Handlers: sync modal inputs to master form and submit
  document.getElementById('btnApplySmtpModal')?.addEventListener('click', () => {
    const source = document.querySelector('input[name="smtp_source_radio"]:checked').value;
    document.getElementById('smtp_config_source_hidden').value = source;
    document.getElementById('custom_smtp_host_hidden').value = document.getElementById('modal_custom_smtp_host').value;
    document.getElementById('custom_smtp_port_hidden').value = document.getElementById('modal_custom_smtp_port').value;
    document.getElementById('custom_smtp_secure_hidden').value = document.getElementById('modal_custom_smtp_secure').checked ? '1' : '0';
    document.getElementById('custom_smtp_user_hidden').value = document.getElementById('modal_custom_smtp_user').value;
    document.getElementById('custom_smtp_pass_hidden').value = document.getElementById('modal_custom_smtp_pass').value;
    document.getElementById('custom_smtp_from_hidden').value = document.getElementById('modal_custom_smtp_from').value;
    document.getElementById('masterSettingsForm').submit();
  });

  document.getElementById('btnApplyGoogleModal')?.addEventListener('click', () => {
    const source = document.querySelector('input[name="google_source_radio"]:checked').value;
    document.getElementById('google_config_source_hidden').value = source;
    document.getElementById('custom_google_client_id_hidden').value = document.getElementById('modal_custom_google_client_id').value;
    document.getElementById('custom_google_client_secret_hidden').value = document.getElementById('modal_custom_google_client_secret').value;
    document.getElementById('masterSettingsForm').submit();
  });

  document.getElementById('btnApplyRestApiModal')?.addEventListener('click', () => {
    const source = document.querySelector('input[name="api_source_radio"]:checked').value;
    document.getElementById('api_config_source_hidden').value = source;
    document.getElementById('custom_api_secret_key_hidden').value = document.getElementById('modal_custom_api_secret_key').value;
    document.getElementById('masterSettingsForm').submit();
  });

  document.getElementById('btnApplySmsModal')?.addEventListener('click', () => {
    const source = document.querySelector('input[name="sms_source_radio"]:checked').value;
    document.getElementById('sms_config_source_hidden').value = source;
    document.getElementById('custom_sms_provider_hidden').value = document.getElementById('modal_custom_sms_provider').value;
    document.getElementById('custom_sms_api_key_hidden').value = document.getElementById('modal_custom_sms_api_key').value;
    document.getElementById('custom_sms_sender_id_hidden').value = document.getElementById('modal_custom_sms_sender_id').value;
    document.getElementById('masterSettingsForm').submit();
  });
</script>

