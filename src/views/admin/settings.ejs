<%- include('../layouts/header', { title: 'App Settings & API Gateway Management - QuickFile' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
  <div>
    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-2">
      OTH-ASI &bull; Dual-Tier API & Integration Management
    </span>
    <h2 class="fw-bold mb-1">App Settings & Pluggable Integrations</h2>
    <p class="text-muted small mb-0">
      Configure system integrations using <strong>Developer Default Presets</strong> (out-of-the-box system defaults) or <strong>Client Custom APIs</strong> (configured by your barangay).
    </p>
  </div>
  <div>
    <a href="/admin/dashboard" class="btn btn-outline-secondary rounded-pill px-3">
      <i class="bi bi-arrow-left me-1"></i> Return to Admin Dashboard
    </a>
  </div>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
    <i class="bi bi-exclamation-circle-fill me-2"></i> <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="alert alert-info border-info-subtle bg-info-subtle text-dark d-flex align-items-start gap-3 rounded-4 mb-4">
  <i class="bi bi-info-circle-fill fs-4 text-primary mt-1"></i>
  <div>
    <h6 class="fw-bold mb-1">Dual-Tier API Architecture</h6>
    <p class="small mb-0">
      <strong>Developer Default:</strong> Pre-packaged credentials provided by the developers (via <code>.env</code> presets) to ensure instant zero-config operations.<br>
      <strong>Client Custom API:</strong> Tap or click any service card below to open its API configuration modal, allowing the barangay administrator to set their own Google OAuth, SMTP server, SMS Gateway, or API tokens directly through this UI.
    </p>
  </div>
</div>

<form id="masterSettingsForm" action="/admin/settings" method="POST">
  <div class="row g-4 mb-4">

    <!-- 1. Google OAuth Pluggable Integration Card -->
    <div class="col-lg-6">
      <div class="card card-custom p-4 h-100 border-<%= settings.googleAuthEnabled ? 'primary' : 'light' %> shadow-sm position-relative">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div class="d-flex align-items-center gap-3">
            <div class="avatar-circle <%= settings.googleAuthEnabled ? 'bg-primary' : 'bg-secondary' %> text-white">
              <i class="bi bi-google fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0">Google Authentication (OAuth)</h5>
              <small class="text-muted">Pluggable Social Sign-In Provider</small>
            </div>
          </div>
          <div class="text-end">
            <% if (settings.googleAuthEnabled) { %>
              <span class="badge bg-success-subtle text-success border border-success-subtle mb-1 d-inline-block">Enabled</span>
            <% } else { %>
              <span class="badge bg-danger-subtle text-danger border border-danger-subtle mb-1 d-inline-block">Disabled</span>
            <% } %>
            <div>
              <% if (settings.googleConfigSource === 'custom') { %>
                <span class="badge bg-purple text-white" style="background-color: #6f42c1 !important;">
                  <i class="bi bi-person-gear me-1"></i> Client Custom API
                </span>
              <% } else { %>
                <span class="badge bg-secondary text-white">
                  <i class="bi bi-code-slash me-1"></i> Developer Preset (Default)
                </span>
              <% } %>
            </div>
          </div>
        </div>

        <p class="text-muted small mb-3">
          When <strong>Enabled</strong>, citizens can sign in or register with one click using Google. When <strong>Disabled</strong>, logins are restricted to manual email & password.
        </p>

        <!-- Current Configuration Preview -->
        <div class="bg-light p-3 rounded-3 mb-3 border">
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="googleAuthSwitch" name="google_auth_enabled" value="1" <%= settings.googleAuthEnabled ? 'checked' : '' %>>
            <label class="form-check-label fw-bold" for="googleAuthSwitch">
              Enable Google OAuth Sign-In for Citizens
            </label>
          </div>

          <div class="small text-muted mb-2">
            <strong>Active Client ID:</strong>
            <span class="font-monospace text-dark d-block text-truncate">
              <%= settings.activeGoogle.clientId || 'Not configured (using dev default)' %>
            </span>
          </div>

          <!-- Hidden inputs to submit current values if not modified via modal -->
          <input type="hidden" name="google_config_source" id="google_config_source_hidden" value="<%= settings.googleConfigSource %>">
          <input type="hidden" name="custom_google_client_id" id="custom_google_client_id_hidden" value="<%= settings.customGoogle.clientId %>">
          <input type="hidden" name="custom_google_client_secret" id="custom_google_client_secret_hidden" value="<%= settings.customGoogle.clientSecret %>">

          <button type="button" class="btn btn-outline-primary btn-sm rounded-pill w-100 mt-2" data-bs-toggle="modal" data-bs-target="#modalGoogleConfig">
            <i class="bi bi-sliders me-1"></i> Configure Google API (Default vs Custom)
          </button>
        </div>

        <div class="mt-auto small text-muted">
          <i class="bi bi-shield-lock me-1"></i> Authentication Route: <code>/citizen/auth/google</code>
        </div>
      </div>
    </div>

    <!-- 2. REST API Pluggable Gateway Card -->
    <div class="col-lg-6">
      <div class="card card-custom p-4 h-100 border-<%= settings.apiEnabled ? 'primary' : 'light' %> shadow-sm">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div class="d-flex align-items-center gap-3">
            <div class="avatar-circle <%= settings.apiEnabled ? 'bg-primary' : 'bg-secondary' %> text-white">
              <i class="bi bi-hdd-network fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0">REST API & External Gateway</h5>
              <small class="text-muted">Pluggable API Service & Access Control</small>
            </div>
          </div>
          <div class="text-end">
            <% if (settings.apiEnabled) { %>
              <span class="badge bg-success-subtle text-success border border-success-subtle mb-1 d-inline-block">
                <i class="bi bi-check-circle-fill me-1"></i> Enabled (Active)
              </span>
            <% } else { %>
              <span class="badge bg-danger-subtle text-danger border border-danger-subtle mb-1 d-inline-block">
                <i class="bi bi-slash-circle-fill me-1"></i> Disabled (Blocked)
              </span>
            <% } %>
            <div>
              <% if (settings.apiConfigSource === 'custom') { %>
                <span class="badge bg-purple text-white" style="background-color: #6f42c1 !important;">
                  <i class="bi bi-person-gear me-1"></i> Client Custom API
                </span>
              <% } else { %>
                <span class="badge bg-secondary text-white">
                  <i class="bi bi-code-slash me-1"></i> Developer Preset (Default)
                </span>
              <% } %>
            </div>
          </div>
        </div>

        <p class="text-muted small mb-3">
          When <strong>Enabled</strong>, external integrations and mobile apps can access <code>/api/*</code>. When <strong>Disabled</strong>, requests return <code>503 Service Unavailable</code>.
        </p>

        <!-- Current Configuration Preview -->
        <div class="bg-light p-3 rounded-3 mb-3 border">
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="apiSwitch" name="api_enabled" value="1" <%= settings.apiEnabled ? 'checked' : '' %>>
            <label class="form-check-label fw-bold" for="apiSwitch">
              Enable REST API Gateway Endpoints (<code>/api/*</code>)
            </label>
          </div>

          <div class="small text-muted mb-2">
            <strong>Active API Secret:</strong>
            <span class="font-monospace text-dark d-block">
              <%= settings.activeApi.secretKey ? '••••••••••••••••' + settings.activeApi.secretKey.slice(-4) : 'None (Open Gateway)' %>
            </span>
          </div>

          <!-- Hidden inputs for REST API -->
          <input type="hidden" name="api_config_source" id="api_config_source_hidden" value="<%= settings.apiConfigSource %>">
          <input type="hidden" name="custom_api_secret_key" id="custom_api_secret_key_hidden" value="<%= settings.customApi.secretKey %>">

          <div class="d-flex gap-2 mt-2">
            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill flex-grow-1" data-bs-toggle="modal" data-bs-target="#modalRestApiConfig">
              <i class="bi bi-key me-1"></i> Configure API Key (Default vs Custom)
            </button>
            <button type="submit" formaction="/admin/settings/toggle-api" class="btn btn-sm <%= settings.apiEnabled ? 'btn-outline-danger' : 'btn-outline-success' %> rounded-pill px-3">
              <i class="bi <%= settings.apiEnabled ? 'bi-toggle-on' : 'bi-toggle-off' %> me-1"></i>
              <%= settings.apiEnabled ? 'Disable' : 'Enable' %>
            </button>
          </div>
        </div>

        <div class="mt-auto small text-muted">
          <i class="bi bi-shield-check me-1"></i> Base API Endpoint: <code>/api</code> &bull; Status: <strong><%= settings.apiEnabled ? 'Active' : 'Disabled' %></strong>
        </div>
      </div>
    </div>

    <!-- 3. Additional Pluggable Services (SMTP & SMS & QR) -->
    <div class="col-12">
      <div class="card card-custom p-4 shadow-sm">
        <h5 class="fw-bold mb-3 d-flex align-items-center">
          <i class="bi bi-plug-fill text-warning me-2"></i> Communication & Verification Services
        </h5>

        <div class="row g-4">
          <!-- SMTP Email Service Card -->
          <div class="col-lg-6">
            <div class="p-4 border rounded-3 bg-light h-100 d-flex flex-column shadow-sm">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" id="emailSwitch" name="email_smtp_enabled" value="1" <%= settings.emailSmtpEnabled ? 'checked' : '' %>>
                    <label class="form-check-label fw-bold fs-6" for="emailSwitch">SMTP / Email Service</label>
                  </div>
                  <small class="text-muted">Automated password recovery & clearance dispatch</small>
                </div>
                <div class="text-end">
                  <% if (settings.emailSmtpEnabled) { %>
                    <span class="badge bg-success mb-1 d-inline-block">Active</span>
                  <% } else { %>
                    <span class="badge bg-secondary mb-1 d-inline-block">Inactive</span>
                  <% } %>
                  <div>
                    <% if (settings.smtpConfigSource === 'custom') { %>
                      <span class="badge bg-purple text-white" style="background-color: #6f42c1 !important;">
                        <i class="bi bi-person-gear me-1"></i> Client Custom API
                      </span>
                    <% } else { %>
                      <span class="badge bg-secondary text-white">
                        <i class="bi bi-code-slash me-1"></i> Developer Preset (Default)
                      </span>
                    <% } %>
                  </div>
                </div>
              </div>

              <!-- Active SMTP Details -->
              <div class="bg-white p-3 rounded border my-3">
                <div class="d-flex justify-content-between small text-muted mb-1">
                  <span>Host & Port:</span>
                  <span class="fw-semibold text-dark font-monospace"><%= settings.activeSmtp.host %>:<%= settings.activeSmtp.port %></span>
                </div>
                <div class="d-flex justify-content-between small text-muted mb-1">
                  <span>Sender Account:</span>
                  <span class="fw-semibold text-primary font-monospace text-truncate ms-2"><%= settings.activeSmtp.user || 'Not set' %></span>
                </div>
                <div class="d-flex justify-content-between small text-muted">
                  <span>SSL/TLS:</span>
                  <span class="fw-semibold text-success"><%= settings.activeSmtp.secure ? 'Enabled (SSL 465)' : 'STARTTLS (587)' %></span>
                </div>
              </div>

              <!-- Hidden inputs for SMTP -->
              <input type="hidden" name="smtp_config_source" id="smtp_config_source_hidden" value="<%= settings.smtpConfigSource %>">
              <input type="hidden" name="custom_smtp_host" id="custom_smtp_host_hidden" value="<%= settings.customSmtp.host %>">
              <input type="hidden" name="custom_smtp_port" id="custom_smtp_port_hidden" value="<%= settings.customSmtp.port %>">
              <input type="hidden" name="custom_smtp_secure" id="custom_smtp_secure_hidden" value="<%= settings.customSmtp.secure ? '1' : '0' %>">
              <input type="hidden" name="custom_smtp_user" id="custom_smtp_user_hidden" value="<%= settings.customSmtp.user %>">
              <input type="hidden" name="custom_smtp_pass" id="custom_smtp_pass_hidden" value="<%= settings.customSmtp.pass %>">
              <input type="hidden" name="custom_smtp_from" id="custom_smtp_from_hidden" value="<%= settings.customSmtp.from %>">

              <div class="mt-auto d-flex gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill flex-grow-1" data-bs-toggle="modal" data-bs-target="#modalSmtpConfig">
                  <i class="bi bi-gear-fill me-1"></i> Configure SMTP API (Default vs Custom)
                </button>
                <button type="submit" formaction="/admin/settings/test-email" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Send a test email using active SMTP configuration">
                  <i class="bi bi-send-fill me-1"></i> Test Email
                </button>
              </div>
            </div>
          </div>

          <!-- SMS Gateway Service Card -->
          <div class="col-lg-6">
            <div class="p-4 border rounded-3 bg-light h-100 d-flex flex-column shadow-sm">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" id="smsSwitch" name="sms_notifications_enabled" value="1" <%= settings.smsNotificationsEnabled ? 'checked' : '' %>>
                    <label class="form-check-label fw-bold fs-6" for="smsSwitch">SMS Gateway Notifications</label>
                  </div>
                  <small class="text-muted">Real-time SMS alerts (PhilSMS / Twilio)</small>
                </div>
                <div class="text-end">
                  <% if (settings.smsNotificationsEnabled) { %>
                    <span class="badge bg-success mb-1 d-inline-block">Active</span>
                  <% } else { %>
                    <span class="badge bg-secondary mb-1 d-inline-block">Inactive</span>
                  <% } %>
                  <div>
                    <% if (settings.smsConfigSource === 'custom') { %>
                      <span class="badge bg-purple text-white" style="background-color: #6f42c1 !important;">
                        <i class="bi bi-person-gear me-1"></i> Client Custom API
                      </span>
                    <% } else { %>
                      <span class="badge bg-secondary text-white">
                        <i class="bi bi-code-slash me-1"></i> Developer Preset (Default)
                      </span>
                    <% } %>
                  </div>
                </div>
              </div>

              <!-- Active SMS Details -->
              <div class="bg-white p-3 rounded border my-3">
                <div class="d-flex justify-content-between small text-muted mb-1">
                  <span>Provider:</span>
                  <span class="fw-semibold text-dark"><%= settings.activeSms.provider || 'PhilSMS' %></span>
                </div>
                <div class="d-flex justify-content-between small text-muted mb-1">
                  <span>Sender ID:</span>
                  <span class="fw-semibold text-primary font-monospace"><%= settings.activeSms.senderId || 'BRGY_CENTRAL' %></span>
                </div>
                <div class="d-flex justify-content-between small text-muted">
                  <span>API Key:</span>
                  <span class="fw-semibold text-muted font-monospace"><%= settings.activeSms.apiKey ? '••••••••' + settings.activeSms.apiKey.slice(-4) : 'Default Dev Key' %></span>
                </div>
              </div>

              <!-- Hidden inputs for SMS -->
              <input type="hidden" name="sms_config_source" id="sms_config_source_hidden" value="<%= settings.smsConfigSource %>">
              <input type="hidden" name="custom_sms_provider" id="custom_sms_provider_hidden" value="<%= settings.customSms.provider %>">
              <input type="hidden" name="custom_sms_api_key" id="custom_sms_api_key_hidden" value="<%= settings.customSms.apiKey %>">
              <input type="hidden" name="custom_sms_sender_id" id="custom_sms_sender_id_hidden" value="<%= settings.customSms.senderId %>">

              <div class="mt-auto">
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill w-100" data-bs-toggle="modal" data-bs-target="#modalSmsConfig">
                  <i class="bi bi-chat-dots me-1"></i> Configure SMS API (Default vs Custom)
                </button>
              </div>
            </div>
          </div>

          <!-- Internal QR Engine Card -->
          <div class="col-12">
            <div class="p-3 border rounded-3 bg-light d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center gap-3">
                <i class="bi bi-qr-code-scan text-primary fs-3"></i>
                <div>
                  <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" id="qrSwitch" name="qr_engine_enabled" value="1" <%= settings.qrEngineEnabled ? 'checked' : '' %>>
                    <label class="form-check-label fw-bold" for="qrSwitch">Internal QR Code Verification Engine</label>
                  </div>
                  <small class="text-muted">Generates cryptographic QR codes printed onto issued certificates for real-time validation.</small>
                </div>
              </div>
              <div>
                <% if (settings.qrEngineEnabled) { %>
                  <span class="badge bg-success">Active</span>
                <% } else { %>
                  <span class="badge bg-secondary">Inactive</span>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Master Save Actions -->
  <div class="card card-custom p-4 bg-light border-0 shadow-sm">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h6 class="fw-bold mb-0">Save Global Integration Changes</h6>
        <small class="text-muted">Applies all toggle statuses and API configurations immediately across citizen and staff portals.</small>
      </div>
      <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">
        <i class="bi bi-save-fill me-1"></i> Save App Settings
      </button>
    </div>
  </div>
</form>

<!-- ======================================================== -->
<!-- MODAL 1: SMTP API Configuration (Default vs Custom)      -->
<!-- ======================================================== -->
<div class="modal fade" id="modalSmtpConfig" tabindex="-1" aria-labelledby="modalSmtpLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content shadow-lg border-0 rounded-4">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title fw-bold" id="modalSmtpLabel">
          <i class="bi bi-envelope-gear me-2"></i> Configure SMTP / Email Service API
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <p class="text-muted small mb-4">
          Choose whether QuickFile should send system emails using the out-of-the-box <strong>Developer Default Presets</strong> or your barangay's <strong>Client Custom SMTP</strong> server.
        </p>

        <!-- Source Selector Tabs / Radios -->
        <div class="card bg-light p-3 mb-4 border">
          <label class="form-label fw-bold small text-uppercase text-muted mb-2">Select Active API Source</label>
          <div class="d-flex gap-4">
            <div class="form-check">
              <input class="form-check-input" type="radio" name="smtp_source_radio" id="smtpSourceDefault" value="default" <%= settings.smtpConfigSource === 'default' ? 'checked' : '' %>>
              <label class="form-check-label fw-semibold" for="smtpSourceDefault">
                <i class="bi bi-code-slash text-secondary me-1"></i> 1. Developer Default (Presets)
              </label>
            </div>
            <div class="form-check">
              <input class="form-check-input" type="radio" name="smtp_source_radio" id="smtpSourceCustom" value="custom" <%= settings.smtpConfigSource === 'custom' ? 'checked' : '' %>>
              <label class="form-check-label fw-semibold" for="smtpSourceCustom">
                <i class="bi bi-person-gear text-primary me-1"></i> 2. Client Custom API (Barangay Setup)
              </label>
            </div>
          </div>
        </div>

        <!-- 1. Developer Default Card View -->
        <div id="smtpDefaultSection" class="<%= settings.smtpConfigSource === 'default' ? '' : 'd-none' %>">
          <div class="alert alert-secondary border">
            <div class="d-flex align-items-center gap-2 mb-2">
              <span class="badge bg-secondary">System Preset</span>
              <strong class="text-dark">Developer Default Out-of-the-Box Configuration</strong>
            </div>
            <p class="small text-muted mb-3">
              Configured by the developer team in <code>.env</code> (<code>DEFAULT_SMTP_*</code>). Ready to dispatch emails without any extra setup.
            </p>
            <div class="row g-2 small font-monospace bg-white p-3 rounded border">
              <div class="col-sm-6 text-muted">SMTP Host: <strong class="text-dark"><%= settings.defaultSmtp.host %></strong></div>
              <div class="col-sm-6 text-muted">SMTP Port: <strong class="text-dark"><%= settings.defaultSmtp.port %></strong></div>
              <div class="col-sm-6 text-muted">Sender Account: <strong class="text-dark"><%= settings.defaultSmtp.user %></strong></div>
              <div class="col-sm-6 text-muted">SSL/TLS Secure: <strong class="text-dark"><%= settings.defaultSmtp.secure ? 'true' : 'false' %></strong></div>
              <div class="col-12 text-muted">From Header: <strong class="text-dark"><%= settings.defaultSmtp.from %></strong></div>
            </div>
          </div>
        </div>

        <!-- 2. Client Custom API Inputs -->
        <div id="smtpCustomSection" class="<%= settings.smtpConfigSource === 'custom' ? '' : 'd-none' %>">
          <div class="border rounded-3 p-3 bg-white mb-3">
            <h6 class="fw-bold text-primary mb-3">
              <i class="bi bi-sliders me-1"></i> Client Custom SMTP Credentials
            </h6>
            <div class="row g-3">
              <div class="col-md-8">
                <label class="form-label small fw-semibold">SMTP Host / Server</label>
                <input type="text" id="modal_custom_smtp_host" class="form-control form-control-sm font-monospace" placeholder="smtp.gmail.com or mail.barangay.gov.ph" value="<%= settings.customSmtp.host %>">
              </div>
              <div class="col-md-4">
                <label class="form-label small fw-semibold">Port</label>
                <input type="number" id="modal_custom_smtp_port" class="form-control form-control-sm font-monospace" placeholder="465" value="<%= settings.customSmtp.port %>">
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-semibold">Username / Email Address</label>
                <input type="email" id="modal_custom_smtp_user" class="form-control form-control-sm font-monospace" placeholder="barangay.official@gmail.com" value="<%= settings.customSmtp.user %>">
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-semibold">App Password / Secret Key</label>
                <input type="password" id="modal_custom_smtp_pass" class="form-control form-control-sm font-monospace" placeholder="••••••••••••••••" value="<%= settings.customSmtp.pass %>">
                <small class="text-muted" style="font-size: 11px;">For Gmail, generate a 16-character Google App Password.</small>
              </div>
              <div class="col-md-8">
                <label class="form-label small fw-semibold">Custom Sender Display (From Header)</label>
                <input type="text" id="modal_custom_smtp_from" class="form-control form-control-sm" placeholder='"Barangay Central Services" <barangay.official@gmail.com>' value="<%= settings.customSmtp.from %>">
              </div>
              <div class="col-md-4 d-flex align-items-center pt-3">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" id="modal_custom_smtp_secure" <%= settings.customSmtp.secure ? 'checked' : '' %>>
                  <label class="form-check-label small fw-semibold" for="modal_custom_smtp_secure">SSL/TLS (Port 465)</label>
                </div>
              </div>
            </div>
          </div>
