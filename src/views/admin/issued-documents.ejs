<%- include('../layouts/header', { title: 'Issued Document Verification & Monitoring (ADM-IDV) - QuickFile' }) %>

<div class="row g-4 mb-4">
  <div class="col-12">
    <div class="card card-custom p-4 bg-dark text-white border-0 shadow">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-semibold mb-2">
            ADM-IDV &bull; Issued Document Governance & Oversight
          </span>
          <h2 class="fw-bold mb-1">Issued Documents & Electronic Validity</h2>
          <p class="mb-0 text-white-50">
            Monitor all officially released certificates, verify digital signatures, and revoke or reinstate validity status (ADM-IDV-01 & ADM-IDV-02).
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Search & Monitor Console (ADM-IDV-02) -->
<div class="card card-custom p-4 mb-4 shadow-sm">
  <form action="/admin/issued-documents" method="GET" class="row g-3">
    <div class="col-md-9">
      <div class="input-group">
        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
        <input type="text" name="search" class="form-control form-control-lg" placeholder="Search by Certificate Number, Verification Code, Citizen Name, or Tracking Number..." value="<%= searchQuery || '' %>">
      </div>
    </div>
    <div class="col-md-3 d-flex gap-2">
      <button type="submit" class="btn btn-primary rounded-pill w-100 fw-semibold">
        <i class="bi bi-search me-1"></i> Filter Issued Docs
      </button>
      <% if (searchQuery) { %>
        <a href="/admin/issued-documents" class="btn btn-outline-secondary rounded-pill">Clear</a>
      <% } %>
    </div>
  </form>
</div>

<!-- Issued Documents Table (ADM-IDV-01 & ADM-IDV-02) -->
<div class="card card-custom p-4 shadow-sm">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h5 class="fw-bold mb-0">Official Barangay Certificates (<%= issuedDocs ? issuedDocs.length : 0 %> Monitored)</h5>
      <span class="text-muted small">Every issued document has a cryptographically verifiable QR code linked to this ledger.</span>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Certificate No.</th>
          <th>Verification Code</th>
          <th>Document</th>
          <th>Citizen Recipient</th>
          <th>Issued Date</th>
          <th>Validity Status (ADM-IDV-01)</th>
          <th>QR Signature</th>
          <th class="text-end">Administrative Control</th>
        </tr>
      </thead>
      <tbody>
        <% if (issuedDocs && issuedDocs.length > 0) { %>
          <% issuedDocs.forEach(function(doc) { %>
            <tr>
              <td><code><%= doc.certificate_number %></code></td>
              <td><code><%= doc.verification_code %></code></td>
              <td class="fw-semibold"><%= doc.document_name %></td>
              <td>
                <div class="fw-bold"><%= doc.citizen_name %></div>
                <small class="text-muted"><%= doc.citizen_email %></small>
              </td>
              <td><%= new Date(doc.issued_at).toLocaleDateString() %></td>
              <td>
                <% if (doc.validity_status === 'VALID') { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                    <i class="bi bi-patch-check-fill me-1"></i> VALID
                  </span>
                <% } else if (doc.validity_status === 'REVOKED') { %>
                  <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2" title="Reason: <%= doc.revoked_reason %>">
                    <i class="bi bi-x-octagon-fill me-1"></i> REVOKED
                  </span>
                  <div class="text-danger small mt-1"><%= doc.revoked_reason %></div>
                <% } else { %>
                  <span class="badge bg-secondary"><%= doc.validity_status %></span>
                <% } %>
              </td>
              <td>
                <% if (doc.qr_code_image) { %>
                  <img src="<%= doc.qr_code_image %>" alt="QR" style="width: 44px; height: 44px;" class="border rounded p-1">
                <% } %>
              </td>
              <td class="text-end">
                <div class="d-flex justify-content-end gap-1">
                  <!-- Public Verify Button -->
                  <a href="/verify/<%= doc.verification_code %>" target="_blank" class="btn btn-sm btn-outline-info rounded-pill" title="Public QR Verification Portal">
                    <i class="bi bi-qr-code-scan"></i>
                  </a>

                  <% if (doc.validity_status === 'VALID') { %>
                    <!-- Revoke Trigger Modal (ADM-IDV-01) -->
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill" data-bs-toggle="modal" data-bs-target="#revokeModal-<%= doc.id %>">
                      <i class="bi bi-shield-x me-1"></i> Revoke
                    </button>
                  <% } else { %>
                    <!-- Reinstate Form (ADM-IDV-01) -->
                    <form action="/admin/issued-documents/<%= doc.id %>/reinstate" method="POST" onsubmit="return confirm('Reinstate validity of Certificate <%= doc.certificate_number %>?');" class="d-inline">
                      <button type="submit" class="btn btn-sm btn-outline-success rounded-pill">
                        <i class="bi bi-shield-check me-1"></i> Reinstate
                      </button>
                    </form>
                  <% } %>
                </div>

                <!-- Revoke Modal (ADM-IDV-01) -->
                <div class="modal fade" id="revokeModal-<%= doc.id %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog text-start">
                    <div class="modal-content">
                      <form action="/admin/issued-documents/<%= doc.id %>/revoke" method="POST">
                        <div class="modal-header bg-danger text-white">
                          <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Revoke Document Validity (ADM-IDV-01)</h5>
                          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                          <p>You are officially revoking Certificate <strong><%= doc.certificate_number %></strong> issued to <strong><%= doc.citizen_name %></strong>.</p>
                          <p class="text-muted small">Anyone scanning this certificate's QR code or querying the verification portal will immediately see that this certificate has been REVOKED and is no longer valid.</p>
                          <div class="mb-3">
                            <label class="form-label fw-semibold">Official Reason for Revocation *</label>
                            <textarea name="reason" class="form-control" rows="3" placeholder="e.g. Fraudulent residency declaration, document superseded by revised clearance, or resident relocation." required></textarea>
                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-danger rounded-pill px-4">Confirm Revocation</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>

              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="8" class="text-center text-muted py-4">No issued documents recorded.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../layouts/footer') %>
