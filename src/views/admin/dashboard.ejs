<%- include('../layouts/header', { title: 'Barangay Administrator Dashboard - QuickFile' }) %>

<div class="row g-4 mb-4">
  <div class="col-12">
    <div class="card card-custom p-4 bg-dark text-white border-0">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-semibold mb-2">
            ADM-IAM &bull; Administrator Session Active (ADM-IAM-01)
          </span>
          <h2 class="fw-bold mb-1"><%= admin.full_name %></h2>
          <p class="mb-0 text-white-50">
            System Administrator &bull; <%= admin.email %> &bull; Barangay Central
          </p>
        </div>
        <div class="d-flex gap-2">
          <a href="/admin/staff-management" class="btn btn-warning rounded-pill fw-semibold text-dark">
            <i class="bi bi-people-fill me-1"></i> Staff & Role Management (ADM-URM)
          </a>
          <a href="/admin/settings" class="btn btn-outline-warning rounded-pill fw-semibold">
            <i class="bi bi-gear-fill me-1"></i> App Settings & Integrations
          </a>
          <a href="/admin/logout" class="btn btn-outline-light rounded-pill">
            <i class="bi bi-box-arrow-right me-1"></i> Admin Logout (ADM-IAM-02)
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Stats Row for Staff Management -->
<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="card card-custom p-4 text-center">
      <div class="avatar-circle bg-primary-subtle text-primary mx-auto mb-2" style="width: 50px; height: 50px;">
        <i class="bi bi-people fs-4"></i>
      </div>
      <h3 class="fw-bold mb-0"><%= totalStaff %></h3>
      <span class="text-muted small">Total Staff Accounts (ADM-URM)</span>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card card-custom p-4 text-center">
      <div class="avatar-circle bg-success-subtle text-success mx-auto mb-2" style="width: 50px; height: 50px;">
        <i class="bi bi-person-check fs-4"></i>
      </div>
      <h3 class="fw-bold mb-0 text-success"><%= activeStaff %></h3>
      <span class="text-muted small">Active Staff Accounts</span>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card card-custom p-4 text-center">
      <div class="avatar-circle bg-danger-subtle text-danger mx-auto mb-2" style="width: 50px; height: 50px;">
        <i class="bi bi-person-slash fs-4"></i>
      </div>
      <h3 class="fw-bold mb-0 text-danger"><%= deactivatedStaff %></h3>
      <span class="text-muted small">Deactivated Accounts (ADM-URM-03)</span>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-12">
    <div class="card card-custom p-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h4 class="fw-bold mb-1">Staff Accounts & Access Management</h4>
          <p class="text-muted small mb-0">Manage personnel credentials and module access permissions.</p>
        </div>
        <a href="/admin/staff-management" class="btn btn-primary rounded-pill btn-sm px-3">
          <i class="bi bi-gear-fill me-1"></i> Open Staff & Roles Console
        </a>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Employee ID</th>
              <th>Full Name</th>
              <th>Email</th>
              <th>Position / Dept</th>
              <th>Account Status (ADM-URM-03)</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% staffList.forEach(function(s) { %>
              <tr>
                <td><code><%= s.employee_id || 'N/A' %></code></td>
                <td class="fw-semibold"><%= s.full_name %></td>
                <td><%= s.email %></td>
                <td><%= s.position || 'Staff' %> <small class="text-muted">(<%= s.department %>)</small></td>
                <td>
                  <% if (s.is_active) { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                  <% } else { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Deactivated</span>
                  <% } %>
                </td>
                <td>
                  <a href="/admin/staff-management#staff-<%= s.id %>" class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="bi bi-sliders me-1"></i> Manage Roles
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

