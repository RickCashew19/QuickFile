<%- include('./layouts/header', { title: 'QuickFile - Barangay Portal' }) %>

<div class="py-5 text-center">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold mb-3">
        Republic of the Philippines &bull; Barangay Central
      </span>
      <h1 class="display-5 fw-bold text-dark mb-3">Barangay Document Request & Management System</h1>
      <p class="lead text-muted mb-4">
        Welcome to <strong>QuickFile</strong>. Select your portal below to access citizen services, staff processing desks, or administrative oversight.
      </p>
      <div class="d-flex justify-content-center gap-2 mb-3">
        <a href="/verify" class="btn btn-warning rounded-pill px-4 fw-semibold text-dark shadow-sm">
          <i class="bi bi-qr-code-scan me-2"></i> Verify Official Barangay Document (CIT-RHV-02 / STF-QDV)
        </a>
      </div>
    </div>
  </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="row g-4 mb-5">
  <!-- Citizen Portal -->
  <div class="col-md-4">
    <div class="card card-custom portal-card h-100 p-4 text-center">
      <div class="avatar-circle bg-primary text-white mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
        <i class="bi bi-person-fill"></i>
      </div>
      <h4 class="fw-bold mb-2">Citizen Portal</h4>
      <p class="text-muted small mb-4">
        Request official clearances, upload requirements, track status in real-time, and download QR-verified certificates (CIT-DCR, CIT-ODR, CIT-RST, CIT-RHV).
      </p>
      <div class="mt-auto d-grid gap-2">
        <a href="/citizen/login" class="btn btn-primary rounded-pill">
          <i class="bi bi-box-arrow-in-right me-1"></i> Citizen Login (CIT-IAM-02)
        </a>
        <a href="/citizen/register" class="btn btn-outline-primary rounded-pill">
          <i class="bi bi-person-plus me-1"></i> New Registration (CIT-IAM-01)
        </a>
      </div>
      <div class="mt-3">
        <small class="text-muted"><a href="/citizen/forgot-password" class="text-decoration-none">Forgot Password? (CIT-IAM-04)</a></small>
      </div>
    </div>
  </div>

  <!-- Staff Portal -->
  <div class="col-md-4">
    <div class="card card-custom portal-card h-100 p-4 text-center">
      <div class="avatar-circle bg-info text-white mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
        <i class="bi bi-shield-lock-fill"></i>
      </div>
      <h4 class="fw-bold mb-2">Barangay Staff Desk</h4>
      <p class="text-muted small mb-4">
        Authorized staff portal for processing citizen requests, verifying profiles, and releasing barangay records.
      </p>
      <div class="mt-auto d-grid gap-2">
        <a href="/staff/login" class="btn btn-info text-white rounded-pill">
          <i class="bi bi-shield-check me-1"></i> Staff Login (STF-IAM-01)
        </a>
      </div>
      <div class="mt-3">
        <small class="text-muted">Requires administrator-provisioned account</small>
      </div>
    </div>
  </div>

  <!-- Admin Portal -->
  <div class="col-md-4">
    <div class="card card-custom portal-card h-100 p-4 text-center">
      <div class="avatar-circle bg-dark text-white mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
        <i class="bi bi-person-gear"></i>
      </div>
      <h4 class="fw-bold mb-2">Barangay Official / Admin</h4>
      <p class="text-muted small mb-4">
        Barangay leadership portal for managing staff accounts, role access control, and system security.
      </p>
      <div class="mt-auto d-grid gap-2">
        <a href="/admin/login" class="btn btn-dark rounded-pill">
          <i class="bi bi-speedometer2 me-1"></i> Admin Login (ADM-IAM-01)
        </a>
        <a href="/admin/staff-management" class="btn btn-outline-dark rounded-pill">
          <i class="bi bi-people-fill me-1"></i> Staff & Roles (ADM-URM)
        </a>
      </div>
      <div class="mt-3">
        <small class="text-muted">Master administrative access only</small>
      </div>
    </div>
  </div>
</div>

<!-- Quick Test Credentials Box -->
<div class="card border-0 bg-light p-4 rounded-4 mb-4">
  <div class="d-flex align-items-center mb-3">
    <i class="bi bi-key-fill text-warning fs-4 me-2"></i>
    <h5 class="fw-bold mb-0">Pre-seeded Test Accounts for Immediate Evaluation</h5>
  </div>
  <div class="row g-3 small">
    <div class="col-md-4">
      <div class="bg-white p-3 rounded-3 border">
        <strong class="text-primary d-block mb-1">Citizen Account:</strong>
        <div>Email: <code>citizen@quickfile.gov.ph</code></div>
        <div>Password: <code>Citizen@123456</code></div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="bg-white p-3 rounded-3 border">
        <strong class="text-info text-dark d-block mb-1">Barangay Staff:</strong>
        <div>Email: <code>staff@quickfile.gov.ph</code></div>
        <div>Password: <code>Staff@123456</code></div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="bg-white p-3 rounded-3 border">
        <strong class="text-dark d-block mb-1">Barangay Admin:</strong>
        <div>Email: <code>admin@quickfile.gov.ph</code></div>
        <div>Password: <code>Admin@123456</code></div>
      </div>
    </div>
  </div>
</div>

<%- include('./layouts/footer') %>

