<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - QuickFile</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body {
      background-color: #f1f5f9;
      font-family: 'Times New Roman', Times, serif;
      color: #0f172a;
    }
    .print-actions {
      max-width: 8.5in;
      margin: 20px auto 10px;
    }
    .certificate-container {
      width: 8.5in;
      min-height: 11in;
      margin: 0 auto 40px;
      padding: 0.8in;
      background: white;
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
      position: relative;
      border: 3px double #0f172a;
    }
    .certificate-border {
      border: 1px solid #94a3b8;
      height: 100%;
      padding: 24px;
      position: relative;
    }
    .watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 8rem;
      color: rgba(15, 23, 42, 0.03);
      font-weight: 900;
      pointer-events: none;
      user-select: none;
      text-transform: uppercase;
      letter-spacing: 10px;
      white-space: nowrap;
    }
    .cert-header {
      text-align: center;
      line-height: 1.3;
      border-bottom: 2px solid #0f172a;
      padding-bottom: 15px;
      margin-bottom: 30px;
    }
    .cert-title {
      font-size: 2.2rem;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin: 35px 0 25px;
      text-align: center;
      text-decoration: underline;
    }
    .cert-body {
      font-size: 1.15rem;
      line-height: 1.9;
      text-align: justify;
      text-indent: 40px;
      margin-bottom: 30px;
    }
    .signature-section {
      margin-top: 60px;
    }
    .qr-box {
      border: 1px solid #cbd5e1;
      padding: 10px;
      display: inline-block;
      text-align: center;
      background: #f8fafc;
    }
    @media print {
      body {
        background: white;
        margin: 0;
        padding: 0;
      }
      .print-actions {
        display: none !important;
      }
      .certificate-container {
        box-shadow: none;
        margin: 0;
        width: 100%;
        min-height: auto;
        border: 2px solid #000;
        padding: 0.5in;
      }
    }
  </style>
</head>
<body>

  <!-- Non-printing toolbar -->
  <div class="print-actions d-flex justify-content-between align-items-center">
    <div>
      <span class="badge bg-primary px-3 py-2 rounded-pill fw-semibold">
        STF-DPP-02 &bull; Document Printing Engine
      </span>
      <span class="ms-2 font-monospace text-muted">Tracking: <%= reqData.tracking_number %></span>
    </div>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 fw-bold">
        <i class="bi bi-printer-fill me-1"></i> Print / Save as PDF (STF-DPP-02)
      </button>
      <button onclick="window.close()" class="btn btn-outline-secondary rounded-pill px-3">
        Close Window
      </button>
    </div>
  </div>

  <!-- Official Printable Certificate Document -->
  <div class="certificate-container">
    <div class="certificate-border">
      <div class="watermark">BARANGAY CENTRAL</div>

      <!-- Header -->
      <div class="cert-header">
        <div class="text-uppercase small fw-bold text-muted">Republic of the Philippines</div>
        <div class="text-uppercase small fw-bold">Province of Rizal &bull; City of Antipolo</div>
        <h4 class="fw-bold text-uppercase mt-1 mb-0" style="letter-spacing: 1px;">BARANGAY CENTRAL</h4>
        <div class="small fst-italic text-secondary">Office of the Punong Barangay</div>
      </div>

      <!-- Document Title -->
      <div class="cert-title">
        <%= reqData.document_name %>
      </div>

      <!-- Salutation -->
      <p class="fw-bold mb-4" style="font-size: 1.2rem;">TO WHOM IT MAY CONCERN:</p>

      <!-- Certificate Body -->
      <p class="cert-body">
        THIS IS TO CERTIFY that <strong><%= reqData.citizen_name.toUpperCase() %></strong>, of legal age, 
        <%= (formData.civilStatus || 'Single').toLowerCase() %>, Filipino citizen, is a bonafide and permanent resident of 
        <strong><%= formData.completeAddress || 'Barangay Central' %></strong>, whose signature and digital verification seal appear hereunder.
      </p>

      <p class="cert-body">
        BASED ON BARANGAY RECORDS, the aforementioned resident is known in this community to be of good moral character, a law-abiding citizen, and has no derogatory or pending blotter record filed against him/her in this office.
      </p>

      <p class="cert-body">
        THIS CERTIFICATION IS ISSUED upon the request of the interested party for the specific purpose of: 
        <strong class="text-uppercase"><%= reqData.purpose %></strong>, and for whatever legal intent and purposes it may serve.
      </p>

      <p class="cert-body">
        GIVEN AND ISSUED this <strong><%= currentDate %></strong>, at the Barangay Hall of Barangay Central, Philippines.
      </p>

      <!-- Signature & Official QR Stamp Section -->
      <div class="row align-items-end signature-section">
        <!-- QR Code Verification Section -->
        <div class="col-6">
          <div class="qr-box">
            <% if (reqData.qr_code_image) { %>
              <img src="<%= reqData.qr_code_image %>" alt="Verification QR Code" style="width: 130px; height: 130px;">
            <% } else { %>
              <div style="width: 130px; height: 130px;" class="d-flex align-items-center justify-content-center text-muted font-monospace small">
                QR Engine Active
              </div>
            <% } %>
            <div class="font-monospace small fw-bold mt-1 text-dark"><%= reqData.certificate_number || 'CERT-2026-0001' %></div>
            <div class="font-monospace text-muted" style="font-size: 0.7rem;">Code: <%= reqData.verification_code || 'QF-VER-000000' %></div>
            <div class="text-muted fst-italic" style="font-size: 0.65rem;">Scan QR to verify authenticity</div>
          </div>
        </div>

        <!-- Punong Barangay Signature Block -->
        <div class="col-6 text-center">
          <div style="height: 40px;"></div>
          <div class="fw-bold fs-5 text-uppercase border-bottom border-dark pb-1 d-inline-block px-4">
            HON. SUPER ADMIN / BARANGAY CAPTAIN
          </div>
          <div class="small fw-semibold mt-1">Punong Barangay</div>
          <div class="small text-muted">Barangay Central</div>
        </div>
      </div>

      <!-- Dry seal footer notice -->
      <div class="text-center mt-5 pt-3 border-top text-muted" style="font-size: 0.75rem;">
        Note: This document is valid for six (6) months from date of issuance. Valid without dry seal only when verified electronically via QuickFile QR engine.
      </div>
    </div>
  </div>

</body>
</html>

