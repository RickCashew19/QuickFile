<%- include('../layouts/header', { title: 'Staff Desk - QuickFile' }) %>

<div class="row g-4 mb-4">
  <div class="col-12">
    <div class="card card-custom p-4 bg-dark text-white border-0 shadow-sm">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <span class="badge bg-info text-white px-3 py-1 rounded-pill fw-semibold mb-2">
            STF-IAM &bull; Staff Session Active (STF-IAM-01)
          </span>
          <h2 class="fw-bold mb-1"><%= staff.full_name %></h2>
          <p class="mb-0 text-white-50">
            <%= staff.position || 'Barangay Staff' %> &bull; <%= staff.department || 'Document Processing' %> &bull; Employee ID: <%= staff.employee_id || 'N/A' %>
          </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <% if (permissions.can_review_requests) { %>
            <a href="/staff/requests" class="btn btn-warning text-dark rounded-pill fw-semibold">
              <i class="bi bi-inbox-fill me-1"></i> Processing Queue (STF-RVP)
            </a>
          <% } %>
          <% if (permissions.can_verify_qr) { %>
            <a href="/staff/verify" class="btn btn-outline-info rounded-pill">
              <i class="bi bi-qr-code-scan me-1"></i> QR Verify (STF-QDV)
            </a>
          <% } %>
          <a href="/staff/logout" class="btn btn-outline-light rounded-pill">
            <i class="bi bi-box-arrow-right me-1"></i> Logout (STF-IAM-02)
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Processing Statistics Cards -->
<div class="row g-4 mb-4">
  <div class="col-md-3">
    <div class="card card-custom p-3 border-0 bg-white shadow-sm text-center">
      <span class="text-muted small">Pending Review (STF-RVP)</span>
      <h3 class="fw-bold text-warning mb-0"><%= overview.pending_requests || 0 %></h3>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card card-custom p-3 border-0 bg-white shadow-sm text-center">
      <span class="text-muted small">Under Review / Approved</span>
      <h3 class="fw-bold text-primary mb-0"><%= (overview.under_review_requests || 0) + (overview.approved_requests || 0) %></h3>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card card-custom p-3 border-0 bg-white shadow-sm text-center">
      <span class="text-muted small">Ready for Pickup (STF-DPP)</span>
      <h3 class="fw-bold text-success mb-0"><%= overview.ready_requests || 0 %></h3>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card card-custom p-3 border-0 bg-white shadow-sm text-center">
      <span class="text-muted small">Total Released (STF-DPP-03)</span>
      <h3 class="fw-bold text-dark mb-0"><%= overview.released_requests || 0 %></h3>
    </div>
  </div>
</div>

<div class="row g-4 mb-4">
  <!-- Active Processing Queue Preview (STF-RVP-01) -->
  <div class="col-lg-8">
    <div class="card card-custom p-4 border-0 shadow-sm h-100">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-3 py-1 rounded-pill mb-1">
            STF-RVP-01 &bull; Live Queue
          </span>
          <h4 class="fw-bold mb-0">Incoming Citizen Requests</h4>
        </div>
        <% if (permissions.can_review_requests) { %>
          <a href="/staff/requests" class="btn btn-outline-primary btn-sm rounded-pill">
            View All (<%= overview.total_requests || 0 %>) &rarr;
          </a>
        <% } %>
      </div>

      <% if (recentRequests && recentRequests.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Tracking No.</th>
                <th>Citizen Name</th>
                <th>Document</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% recentRequests.forEach(function(r) { %>
                <tr>
                  <td><code class="text-primary fw-bold"><%= r.tracking_number %></code></td>
                  <td class="fw-semibold"><%= r.citizen_name %></td>
                  <td><%= r.document_name %></td>
                  <td>
                    <% if (r.status === 'PENDING') { %>
                      <span class="badge bg-warning text-dark">Pending</span>
                    <% } else if (r.status === 'UNDER_REVIEW') { %>
                      <span class="badge bg-info text-white">Under Review</span>
                    <% } else if (r.status === 'APPROVED') { %>
                      <span class="badge bg-primary">Approved</span>
                    <% } else if (r.status === 'READY_FOR_PICKUP') { %>
                      <span class="badge bg-success">Ready</span>
                    <% } else if (r.status === 'RELEASED') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle">Released</span>
                    <% } else if (r.status === 'REJECTED') { %>
                      <span class="badge bg-danger">Rejected</span>
                    <% } else { %>
                      <span class="badge bg-secondary"><%= r.status %></span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/staff/requests/<%= r.id %>" class="btn btn-sm btn-primary rounded-pill px-3">
                      Process
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-inbox fs-1"></i>
          <p class="mt-2 mb-0">No active document requests in queue.</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Operational Navigation & Permissions -->
  <div class="col-lg-4">
    <div class="card card-custom p-4 border-0 shadow-sm h-100">
      <h5 class="fw-bold mb-3 text-dark">
        <i class="bi bi-sliders text-info me-2"></i> Operational Tools
      </h5>

      <div class="d-grid gap-2 mb-4">
        <% if (permissions.can_review_requests) { %>
          <a href="/staff/requests" class="btn btn-outline-primary text-start rounded-3 p-3">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <strong class="d-block"><i class="bi bi-inbox me-2"></i> Review Queue</strong>
                <small class="text-muted">Review applications & requirements (STF-RVP)</small>
              </div>
              <i class="bi bi-chevron-right"></i>
            </div>
          </a>
        <% } %>

        <% if (permissions.can_verify_qr) { %>
          <a href="/staff/verify" class="btn btn-outline-warning text-dark text-start rounded-3 p-3">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <strong class="d-block"><i class="bi bi-qr-code-scan me-2"></i> QR Verification</strong>
                <small class="text-muted">Verify document authenticity (STF-QDV)</small>
              </div>
              <i class="bi bi-chevron-right"></i>
            </div>
          </a>
        <% } %>

        <% if (permissions.can_archive_records) { %>
          <a href="/staff/records" class="btn btn-outline-secondary text-start rounded-3 p-3">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <strong class="d-block"><i class="bi bi-archive me-2"></i> Records & Archiving</strong>
                <small class="text-muted">Search archived records (STF-RA)</small>
              </div>
              <i class="bi bi-chevron-right"></i>
            </div>
          </a>
        <% } %>

        <% if (permissions.can_view_reports) { %>
          <a href="/staff/reports" class="btn btn-outline-success text-start rounded-3 p-3">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <strong class="d-block"><i class="bi bi-graph-up me-2"></i> Transaction Reports</strong>
                <small class="text-muted">Summaries and workload monitoring (STF-TR)</small>
              </div>
              <i class="bi bi-chevron-right"></i>
            </div>
          </a>
        <% } %>
      </div>

      <div class="p-3 bg-light rounded-3 mt-auto small">
        <span class="text-muted d-block">Barangay Central Staff ID:</span>
        <strong class="font-monospace text-dark"><%= staff.employee_id || 'STF-001' %></strong>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
