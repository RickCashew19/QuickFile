<%- include('../layouts/header', { title: 'Staff Desk - QuickFile' }) %>

<div class="row g-4 mb-4">
  <div class="col-12">
    <div class="card card-custom p-4 bg-dark text-white border-0">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <span class="badge bg-info text-white px-3 py-1 rounded-pill fw-semibold mb-2">
            STF-IAM &bull; Staff Session Active (STF-IAM-01)
          </span>
          <h2 class="fw-bold mb-1"><%= staff.full_name %></h2>
          <p class="mb-0 text-white-50">
            <%= staff.position || 'Barangay Staff' %> &bull; <%= staff.department || 'Document Processing' %> &bull; Employee ID: <%= staff.employee_id || 'N/A' %>
          </p>
        </div>
        <div>
          <a href="/staff/logout" class="btn btn-outline-light rounded-pill">
            <i class="bi bi-box-arrow-right me-1"></i> Staff Logout (STF-IAM-02)
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="row g-4">
  <!-- Staff Access Control Permissions Summary (ADM-URM-04) -->
  <div class="col-lg-8">
    <div class="card card-custom p-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <h4 class="fw-bold mb-1">Assigned Operational Permissions</h4>
          <p class="text-muted small mb-0">Controlled by Barangay Administrator (ADM-URM-04 Access Control Management)</p>
        </div>
        <div class="avatar-circle bg-info-subtle text-info">
          <i class="bi bi-shield-check fs-4"></i>
        </div>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <div class="p-3 border rounded-3 <%= permissions.can_review_requests ? 'border-success bg-success-subtle bg-opacity-10' : 'border-secondary bg-light' %>">
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-semibold">Request Review (STF-RVP)</span>
              <% if (permissions.can_review_requests) { %>
                <span class="badge bg-success">Granted</span>
              <% } else { %>
                <span class="badge bg-secondary">Restricted</span>
              <% } %>
            </div>
            <small class="text-muted">Review attached requirements and citizen requests.</small>
          </div>
        </div>

        <div class="col-md-6">
          <div class="p-3 border rounded-3 <%= permissions.can_prepare_documents ? 'border-success bg-success-subtle bg-opacity-10' : 'border-secondary bg-light' %>">
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-semibold">Document Preparation</span>
              <% if (permissions.can_prepare_documents) { %>
                <span class="badge bg-success">Granted</span>
              <% } else { %>
                <span class="badge bg-secondary">Restricted</span>
              <% } %>
            </div>
            <small class="text-muted">Generate clearances & certifications from profiles.</small>
          </div>
        </div>

        <div class="col-md-6">
          <div class="p-3 border rounded-3 <%= permissions.can_print_documents ? 'border-success bg-success-subtle bg-opacity-10' : 'border-secondary bg-light' %>">
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-semibold">Document Printing (STF-DPP)</span>
              <% if (permissions.can_print_documents) { %>
                <span class="badge bg-success">Granted</span>
              <% } else { %>
                <span class="badge bg-secondary">Restricted</span>
              <% } %>
            </div>
            <small class="text-muted">Print finalized documents with official stamps.</small>
          </div>
        </div>

        <div class="col-md-6">
          <div class="p-3 border rounded-3 <%= permissions.can_release_documents ? 'border-success bg-success-subtle bg-opacity-10' : 'border-secondary bg-light' %>">
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-semibold">Document Release</span>
              <% if (permissions.can_release_documents) { %>
                <span class="badge bg-success">Granted</span>
              <% } else { %>
                <span class="badge bg-secondary">Restricted</span>
              <% } %>
            </div>
            <small class="text-muted">Release printed documents directly to citizens.</small>
          </div>
        </div>

        <div class="col-md-6">
          <div class="p-3 border rounded-3 <%= permissions.can_verify_qr ? 'border-success bg-success-subtle bg-opacity-10' : 'border-secondary bg-light' %>">
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-semibold">QR Code Verification (STF-QDV)</span>
              <% if (permissions.can_verify_qr) { %>
                <span class="badge bg-success">Granted</span>
              <% } else { %>
                <span class="badge bg-secondary">Restricted</span>
              <% } %>
            </div>
            <small class="text-muted">Scan QR codes to authenticate issued documents.</small>
          </div>
        </div>

        <div class="col-md-6">
          <div class="p-3 border rounded-3 <%= permissions.can_view_reports ? 'border-success bg-success-subtle bg-opacity-10' : 'border-secondary bg-light' %>">
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-semibold">Reporting & Analytics (STF-TR)</span>
              <% if (permissions.can_view_reports) { %>
                <span class="badge bg-success">Granted</span>
              <% } else { %>
                <span class="badge bg-secondary">Restricted</span>
              <% } %>
            </div>
            <small class="text-muted">Access daily transaction summaries.</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Staff Quick Details -->
  <div class="col-lg-4">
    <div class="card card-custom p-4">
      <h5 class="fw-bold mb-3">Staff Profile Info</h5>
      <ul class="list-group list-group-flush small mb-3">
        <li class="list-group-item d-flex justify-content-between px-0">
          <span class="text-muted">Staff ID:</span>
          <strong><%= staff.employee_id || 'STF-001' %></strong>
        </li>
        <li class="list-group-item d-flex justify-content-between px-0">
          <span class="text-muted">Work Email:</span>
          <strong><%= staff.email %></strong>
        </li>
        <li class="list-group-item d-flex justify-content-between px-0">
          <span class="text-muted">Contact:</span>
          <strong><%= staff.phone || 'N/A' %></strong>
        </li>
        <li class="list-group-item d-flex justify-content-between px-0">
          <span class="text-muted">Status:</span>
          <span class="badge bg-success">Active Authorized Account</span>
        </li>
      </ul>
      <a href="/staff/logout" class="btn btn-outline-danger w-100 rounded-pill btn-sm">
        <i class="bi bi-box-arrow-right me-1"></i> Log Out of Staff Portal
      </a>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

