<%- include('../layouts/header', { title: 'Archived Document Records - QuickFile' }) %>

<div class="row align-items-center mb-4">
  <div class="col-md-8">
    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1 rounded-pill mb-2">
      STF-RA-01 & STF-RA-02 &bull; Records & Archiving
    </span>
    <h2 class="fw-bold mb-0">Barangay Central Document Archives</h2>
    <p class="text-muted mb-0">Search and retrieve permanent records of previously processed and released barangay documents.</p>
  </div>
  <div class="col-md-4 text-md-end mt-3 mt-md-0">
    <a href="/staff/requests" class="btn btn-outline-primary rounded-pill btn-sm">
      <i class="bi bi-inbox me-1"></i> Active Processing Queue
    </a>
  </div>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Archive Search Bar (STF-RA-02) -->
<div class="card card-custom p-3 mb-4 border-0 shadow-sm">
  <form action="/staff/records" method="GET" class="d-flex gap-2">
    <div class="input-group">
      <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
      <input 
        type="text" 
        name="search" 
        class="form-control" 
        placeholder="Search archive by Resident Name, Tracking Number, or Certificate No..." 
        value="<%= searchQuery %>"
      >
    </div>
    <button type="submit" class="btn btn-secondary px-4 rounded-pill fw-semibold">
      Search Archives
    </button>
  </form>
</div>

<!-- Archives Table -->
<div class="card card-custom p-4 border-0 shadow-sm">
  <% if (records && records.length > 0) { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Tracking No.</th>
            <th>Certificate No.</th>
            <th>Citizen Name</th>
            <th>Document Type</th>
            <th>Timestamps (Created & Archived)</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% records.forEach(function(r) { %>
            <tr>
              <td><code><%= r.tracking_number %></code></td>
              <td>
                <% if (r.certificate_number) { %>
                  <span class="font-monospace text-success fw-bold"><%= r.certificate_number %></span>
                <% } else { %>
                  <span class="text-muted">None</span>
                <% } %>
              </td>
              <td class="fw-semibold"><%= r.citizen_name %></td>
              <td><%= r.document_name %></td>
              <td>
                <div class="small fw-semibold text-dark"><i class="bi bi-calendar-plus text-primary me-1"></i><%= formatDateTime(r.created_at) %></div>
                <small class="text-muted d-block"><i class="bi bi-archive-fill text-secondary me-1"></i>Archived: <%= formatDateTime(r.archived_at || r.updated_at) %></small>
              </td>
              <td>
                <div class="btn-group btn-group-sm">
                  <a href="/staff/requests/<%= r.id %>" class="btn btn-outline-primary rounded-pill px-3">
                    <i class="bi bi-eye me-1"></i> Inspect
                  </a>
                  <% if (r.certificate_number) { %>
                    <a href="/staff/requests/<%= r.id %>/print" target="_blank" class="btn btn-outline-dark rounded-pill px-3 ms-1">
                      <i class="bi bi-printer me-1"></i> Reprint
                    </a>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="text-center py-5">
      <i class="bi bi-archive fs-1 text-muted"></i>
      <h5 class="fw-bold mt-2">No archived records found</h5>
      <p class="text-muted">Completed and released records can be archived from the request detail page.</p>
    </div>
  <% } %>
</div>

<%- include('../layouts/footer') %>

