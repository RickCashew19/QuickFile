<%- include('../layouts/header', { title: 'Transaction Reports & Workload - QuickFile' }) %>

<div class="row align-items-center mb-4">
  <div class="col-md-8">
    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill mb-2">
      STF-TR-01 & STF-TR-02 &bull; Transaction Reporting
    </span>
    <h2 class="fw-bold mb-0">Staff Transaction & Workload Reports</h2>
    <p class="text-muted mb-0">Daily summaries, financial collections, and operational team throughput.</p>
  </div>
  <div class="col-md-4 text-md-end mt-3 mt-md-0">
    <button onclick="window.print()" class="btn btn-outline-dark rounded-pill btn-sm">
      <i class="bi bi-printer me-1"></i> Print / Export Report
    </button>
  </div>
</div>

<!-- Summary Metrics Cards -->
<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="card card-custom p-4 border-0 shadow-sm text-center">
      <span class="text-muted small">Total Requests Analyzed</span>
      <h3 class="fw-bold text-primary mb-0"><%= reportData.summary.totalCount %></h3>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card card-custom p-4 border-0 shadow-sm text-center">
      <span class="text-muted small">Released Certificates</span>
      <h3 class="fw-bold text-success mb-0"><%= reportData.summary.releasedCount %></h3>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card card-custom p-4 border-0 shadow-sm text-center">
      <span class="text-muted small">Total Fees Collected</span>
      <h3 class="fw-bold text-dark mb-0">₱<%= reportData.summary.totalRevenue.toFixed(2) %></h3>
    </div>
  </div>
</div>

<!-- Filter Box -->
<div class="card card-custom p-3 mb-4 border-0 shadow-sm">
  <form action="/staff/reports" method="GET" class="row g-2 align-items-center">
    <div class="col-md-4">
      <label class="small text-muted">From Date</label>
      <input type="date" name="startDate" class="form-control" value="<%= filter.startDate %>">
    </div>
    <div class="col-md-4">
      <label class="small text-muted">To Date</label>
      <input type="date" name="endDate" class="form-control" value="<%= filter.endDate %>">
    </div>
    <div class="col-md-2">
      <label class="small text-muted">Status</label>
      <select name="status" class="form-select">
        <option value="">All</option>
        <option value="RELEASED" <%= filter.status === 'RELEASED' ? 'selected' : '' %>>Released</option>
        <option value="PENDING" <%= filter.status === 'PENDING' ? 'selected' : '' %>>Pending</option>
        <option value="REJECTED" <%= filter.status === 'REJECTED' ? 'selected' : '' %>>Rejected</option>
      </select>
    </div>
    <div class="col-md-2 mt-auto">
      <button type="submit" class="btn btn-primary w-100 rounded-pill fw-semibold">
        Generate Report
      </button>
    </div>
  </form>
</div>

<!-- Workload Monitoring Section (STF-TR-02) -->
<div class="card card-custom p-4 mb-4 border-0 shadow-sm">
  <h5 class="fw-bold mb-3 text-dark">
    <i class="bi bi-people-fill text-info me-2"></i> Staff Workload & Performance Monitoring (STF-TR-02)
  </h5>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Personnel Name</th>
          <th>Designation</th>
          <th>Total Requests Handled</th>
          <th>Released Documents</th>
          <th>Workload Status</th>
        </tr>
      </thead>
      <tbody>
        <% workloadStats.forEach(function(s) { %>
          <tr>
            <td class="fw-bold"><%= s.full_name %></td>
            <td><%= s.position || 'Barangay Staff' %> <small class="text-muted">(<%= s.department %>)</small></td>
            <td><span class="badge bg-primary fs-6 px-3"><%= s.processed_count %></span></td>
            <td><span class="badge bg-success fs-6 px-3"><%= s.released_count %></span></td>
            <td>
              <% if (s.processed_count > 5) { %>
                <span class="badge bg-danger-subtle text-danger">Heavy Load</span>
              <% } else if (s.processed_count > 0) { %>
                <span class="badge bg-success-subtle text-success">Normal Active</span>
              <% } else { %>
                <span class="badge bg-secondary-subtle text-secondary">Available</span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<!-- Transaction Ledger (STF-TR-01) -->
<div class="card card-custom p-4 border-0 shadow-sm">
  <h5 class="fw-bold mb-3 text-dark">
    <i class="bi bi-receipt text-primary me-2"></i> Detailed Transaction Ledger (STF-TR-01)
  </h5>
  <% if (reportData.transactions && reportData.transactions.length > 0) { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 small">
        <thead class="table-light">
          <tr>
            <th>Date</th>
            <th>Tracking No.</th>
            <th>Citizen</th>
            <th>Document Type</th>
            <th>Fee</th>
            <th>Payment</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% reportData.transactions.forEach(function(t) { %>
            <tr>
              <td><%= new Date(t.created_at).toLocaleDateString('en-PH') %></td>
              <td><code><%= t.tracking_number %></code></td>
              <td class="fw-semibold"><%= t.citizen_name %></td>
              <td><%= t.document_name %></td>
              <td>₱<%= t.fee.toFixed(2) %></td>
              <td><span class="badge <%= t.payment_status === 'PAID' ? 'bg-success' : 'bg-warning text-dark' %>"><%= t.payment_status %></span></td>
              <td><span class="badge bg-secondary"><%= t.status %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="text-muted mb-0">No transactions recorded matching the selected filter criteria.</p>
  <% } %>
</div>

<%- include('../layouts/footer') %>
