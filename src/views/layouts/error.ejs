<%- include('./header', { title: title || 'Error - QuickFile' }) %>

<div class="row justify-content-center mt-5">
  <div class="col-md-7 col-lg-6">
    <div class="card shadow-sm border-0 rounded-4 p-4 text-center">
      <div class="mb-3 text-danger">
        <i class="bi bi-exclamation-triangle-fill display-3"></i>
      </div>
      <h3 class="fw-bold mb-2"><%= title || 'Error' %></h3>
      <p class="text-muted mb-4"><%= message || 'Something went wrong.' %></p>
      <div>
        <a href="/" class="btn btn-primary px-4 rounded-pill">
          <i class="bi bi-house me-1"></i> Return to Home
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('./footer') %>
