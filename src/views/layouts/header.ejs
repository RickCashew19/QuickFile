<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'QuickFile - Barangay Document Management' %></title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3 shadow-sm">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <i class="bi bi-file-earmark-check-fill text-warning fs-4"></i>
      <span class="fs-4 fw-bold">QuickFile</span>
      <span class="brand-badge text-white">Barangay Central</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ms-auto align-items-center gap-2">
        <li class="nav-item">
          <a class="nav-link text-warning" href="/verify">
            <i class="bi bi-qr-code-scan me-1"></i> Verify Document
          </a>
        </li>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <% if (currentUser.role === 'citizen') { %>
            <li class="nav-item"><a class="nav-link" href="/citizen/dashboard"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/citizen/catalog"><i class="bi bi-folder2-open me-1"></i> Catalog</a></li>
            <li class="nav-item"><a class="nav-link" href="/citizen/history"><i class="bi bi-clock-history me-1"></i> History & Tracking</a></li>
            <li class="nav-item"><a class="nav-link" href="/citizen/notifications"><i class="bi bi-bell me-1"></i> Alerts</a></li>
            <li class="nav-item"><a class="nav-link" href="/citizen/profile"><i class="bi bi-person-circle me-1"></i> Profile</a></li>
            <li class="nav-item ms-lg-2">
              <a class="btn btn-outline-light btn-sm rounded-pill px-3" href="/citizen/logout">
                <i class="bi bi-box-arrow-right me-1"></i> Logout (<%= currentUser.full_name %>)
              </a>
            </li>
          <% } else if (currentUser.role === 'staff') { %>
            <li class="nav-item"><a class="nav-link" href="/staff/dashboard"><i class="bi bi-speedometer2 me-1"></i> Staff Desk</a></li>
            <li class="nav-item"><a class="nav-link" href="/staff/requests"><i class="bi bi-inboxes-fill me-1"></i> Request Queue</a></li>
            <li class="nav-item"><a class="nav-link" href="/staff/records"><i class="bi bi-archive-fill me-1"></i> Archive</a></li>
            <li class="nav-item"><a class="nav-link" href="/staff/verify"><i class="bi bi-qr-code me-1"></i> QR Verify</a></li>
            <li class="nav-item"><a class="nav-link" href="/staff/reports"><i class="bi bi-bar-chart-line-fill me-1"></i> Reports</a></li>
            <li class="nav-item ms-lg-2">
              <a class="btn btn-outline-light btn-sm rounded-pill px-3" href="/staff/logout">
                <i class="bi bi-box-arrow-right me-1"></i> Staff Logout (<%= currentUser.full_name %>)
              </a>
            </li>
          <% } else if (currentUser.role === 'admin') { %>
            <li class="nav-item"><a class="nav-link" href="/admin/dashboard"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/document-types"><i class="bi bi-file-earmark-text-fill me-1"></i> Doc Types</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/staff-management"><i class="bi bi-people-fill me-1"></i> Staff & Roles</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/citizens"><i class="bi bi-person-lines-fill me-1"></i> Citizens</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/reports"><i class="bi bi-graph-up-arrow me-1"></i> Reports</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/records"><i class="bi bi-search me-1"></i> Records</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/issued-documents"><i class="bi bi-patch-check-fill me-1"></i> Issued Docs</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/audit-logs"><i class="bi bi-shield-shaded me-1"></i> Audit Logs</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/settings"><i class="bi bi-gear-fill me-1"></i> Settings</a></li>
            <li class="nav-item ms-lg-2">
              <a class="btn btn-outline-light btn-sm rounded-pill px-3" href="/admin/logout">
                <i class="bi bi-box-arrow-right me-1"></i> Admin Logout
              </a>
            </li>
          <% } %>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/citizen/login"><i class="bi bi-person me-1"></i> Citizen</a></li>
          <li class="nav-item"><a class="nav-link" href="/staff/login"><i class="bi bi-shield-check me-1"></i> Staff</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/login"><i class="bi bi-person-gear me-1"></i> Official / Admin</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<main class="main-content container py-4">

