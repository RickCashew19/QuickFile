<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'QuickFile - Barangay Document Management' %></title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3 shadow-sm">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <i class="bi bi-file-earmark-check-fill text-warning fs-4"></i>
      <span class="fs-4 fw-bold">QuickFile</span>
      <span class="brand-badge text-white">Barangay Central</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ms-auto align-items-center gap-2">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <% if (currentUser.role === 'citizen') { %>
            <li class="nav-item"><a class="nav-link" href="/citizen/dashboard"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="/citizen/profile"><i class="bi bi-person-circle me-1"></i> My Profile</a></li>
            <li class="nav-item ms-lg-2">
              <a class="btn btn-outline-light btn-sm rounded-pill px-3" href="/citizen/logout">
                <i class="bi bi-box-arrow-right me-1"></i> Logout (<%= currentUser.full_name %>)
              </a>
            </li>
          <% } else if (currentUser.role === 'staff') { %>
            <li class="nav-item"><a class="nav-link" href="/staff/dashboard"><i class="bi bi-briefcase me-1"></i> Staff Desk</a></li>
            <li class="nav-item ms-lg-2">
              <a class="btn btn-outline-light btn-sm rounded-pill px-3" href="/staff/logout">
                <i class="bi bi-box-arrow-right me-1"></i> Staff Logout (<%= currentUser.full_name %>)
              </a>
            </li>
          <% } else if (currentUser.role === 'admin') { %>
            <li class="nav-item"><a class="nav-link" href="/admin/dashboard"><i class="bi bi-speedometer2 me-1"></i> Admin Portal</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/staff-management"><i class="bi bi-people me-1"></i> Staff & Roles</a></li>
            <li class="nav-item"><a class="nav-link" href="/admin/settings"><i class="bi bi-gear-fill me-1"></i> App Settings</a></li>
            <li class="nav-item ms-lg-2">
              <a class="btn btn-outline-light btn-sm rounded-pill px-3" href="/admin/logout">
                <i class="bi bi-box-arrow-right me-1"></i> Admin Logout
              </a>
            </li>
          <% } %>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/citizen/login"><i class="bi bi-person me-1"></i> Citizen</a></li>
          <li class="nav-item"><a class="nav-link" href="/staff/login"><i class="bi bi-shield-check me-1"></i> Staff</a></li>
          <li class="nav-item"><a class="nav-link" href="/admin/login"><i class="bi bi-person-gear me-1"></i> Official / Admin</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<main class="main-content container py-4">

