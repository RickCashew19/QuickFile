<%- include('../layouts/header', { title: 'Citizen Dashboard - QuickFile' }) %>

<div class="row g-4 mb-4">
  <div class="col-12">
    <div class="card card-custom p-4 bg-primary text-white border-0 shadow-sm">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
          <span class="badge bg-white text-primary px-3 py-1 rounded-pill fw-semibold mb-2">
            Citizen Dashboard &bull; Logged In
          </span>
          <h2 class="fw-bold mb-1">Mabuhay, <%= reusableInfo.reusableData.fullName || user.full_name %>!</h2>
          <p class="mb-0 text-white-50">Welcome to your Barangay Central resident service portal.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a href="/citizen/request" class="btn btn-warning text-dark rounded-pill fw-bold px-3">
            <i class="bi bi-file-earmark-plus-fill me-1"></i> Request Document (CIT-ODR)
          </a>
          <a href="/citizen/catalog" class="btn btn-light text-primary rounded-pill fw-semibold">
            <i class="bi bi-grid-fill me-1"></i> View Catalog (CIT-DCR)
          </a>
          <a href="/citizen/profile" class="btn btn-outline-light rounded-pill">
            <i class="bi bi-person-fill-gear me-1"></i> Profile (CIT-APM)
          </a>
          <a href="/citizen/logout" class="btn btn-outline-light rounded-pill">
            <i class="bi bi-box-arrow-right me-1"></i> Logout
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Notification Alert Banner if Unread -->
<% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
  <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
    <div>
      <i class="bi bi-bell-fill me-2"></i> You have <strong><%= unreadCount %></strong> unread notification(s) regarding your document requests.
    </div>
    <a href="/citizen/notifications" class="btn btn-sm btn-info rounded-pill px-3 fw-semibold">
      View Notifications (CIT-RST-02)
    </a>
  </div>
<% } %>

<!-- Quick Action Cards -->
<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="card card-custom p-4 h-100 border-0 bg-white shadow-sm">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="avatar-circle bg-primary-subtle text-primary" style="width: 48px; height: 48px;">
          <i class="bi bi-folder2-open fs-4"></i>
        </div>
        <div>
          <h5 class="fw-bold mb-0">Document Catalog</h5>
          <small class="text-muted">CIT-DCR-01 & CIT-DCR-02</small>
        </div>
      </div>
      <p class="text-muted small">Browse official barangay clearances, certifications, fees, and requirements.</p>
      <a href="/citizen/catalog" class="btn btn-outline-primary btn-sm rounded-pill mt-auto">
        Browse Available Documents &rarr;
      </a>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card card-custom p-4 h-100 border-0 bg-white shadow-sm">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="avatar-circle bg-success-subtle text-success" style="width: 48px; height: 48px;">
          <i class="bi bi-send-check fs-4"></i>
        </div>
        <div>
          <h5 class="fw-bold mb-0">Online Request</h5>
          <small class="text-muted">CIT-ODR-01 & 03</small>
        </div>
      </div>
      <p class="text-muted small">Submit applications with auto-populated profile data and digital proof attachments.</p>
      <a href="/citizen/request" class="btn btn-success btn-sm rounded-pill mt-auto text-white fw-semibold">
        Start New Request &rarr;
      </a>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card card-custom p-4 h-100 border-0 bg-white shadow-sm">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="avatar-circle bg-warning-subtle text-dark" style="width: 48px; height: 48px;">
          <i class="bi bi-clock-history fs-4"></i>
        </div>
        <div>
          <h5 class="fw-bold mb-0">Track & History</h5>
          <small class="text-muted">CIT-RST-01 & CIT-RHV-01</small>
        </div>
      </div>
      <p class="text-muted small">Monitor real-time status, download QR certificates, and view past transactions.</p>
      <a href="/citizen/history" class="btn btn-outline-dark btn-sm rounded-pill mt-auto">
        View Request History (<%= requests.length %>) &rarr;
      </a>
    </div>
  </div>
</div>

<!-- Active Document Requests Section (CIT-RST-01) -->
<div class="row g-4 mb-4">
  <div class="col-12">
    <div class="card card-custom p-4 border-0 shadow-sm">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-1">
            CIT-RST-01 &bull; Status Tracking
          </span>
          <h4 class="fw-bold mb-0">My Recent Document Requests</h4>
        </div>
        <a href="/citizen/history" class="btn btn-outline-secondary btn-sm rounded-pill">
          View All History
        </a>
      </div>

      <% if (requests && requests.length > 0) { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Tracking No.</th>
                <th>Document Type</th>
                <th>Date Submitted</th>
                <th>Fee & Payment</th>
                <th>Current Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% requests.slice(0, 5).forEach(function(r) { %>
                <tr>
                  <td>
                    <span class="font-monospace fw-bold text-primary"><%= r.tracking_number %></span>
                  </td>
                  <td class="fw-semibold"><%= r.document_name %></td>
                  <td class="text-muted small"><%= new Date(r.created_at).toLocaleDateString('en-PH') %></td>
                  <td>
                    <% if (r.fee === 0) { %>
                      <span class="badge bg-secondary-subtle text-secondary">Free / Waived</span>
                    <% } else { %>
                      <span class="fw-semibold">₱<%= r.fee.toFixed(2) %></span>
                      <small class="badge <%= r.payment_status === 'PAID' ? 'bg-success' : 'bg-warning text-dark' %> ms-1">
                        <%= r.payment_status %>
                      </small>
                    <% } %>
                  </td>
                  <td>
                    <% if (r.status === 'PENDING') { %>
                      <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> Pending Review</span>
                    <% } else if (r.status === 'UNDER_REVIEW') { %>
                      <span class="badge bg-info text-white"><i class="bi bi-search me-1"></i> Under Review</span>
                    <% } else if (r.status === 'APPROVED') { %>
                      <span class="badge bg-primary"><i class="bi bi-check-circle me-1"></i> Approved</span>
                    <% } else if (r.status === 'IN_PREPARATION') { %>
                      <span class="badge bg-info text-dark"><i class="bi bi-gear-wide-connected me-1"></i> In Preparation</span>
                    <% } else if (r.status === 'READY_FOR_PICKUP') { %>
                      <span class="badge bg-success"><i class="bi bi-envelope-paper-fill me-1"></i> Ready for Pickup</span>
                    <% } else if (r.status === 'RELEASED') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-award-fill me-1"></i> Released</span>
                    <% } else if (r.status === 'REJECTED') { %>
                      <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> Rejected</span>
                    <% } else { %>
                      <span class="badge bg-secondary"><%= r.status %></span>
                    <% } %>
                  </td>
                  <td>
                    <a href="/citizen/requests/<%= r.tracking_number %>" class="btn btn-outline-primary btn-sm rounded-pill">
                      <i class="bi bi-eye me-1"></i> Track & Details
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="text-center py-5 bg-light rounded-3">
          <i class="bi bi-folder-x fs-1 text-muted"></i>
          <p class="text-muted mt-2 mb-3">You have not submitted any document requests yet.</p>
          <a href="/citizen/request" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-circle me-1"></i> Submit Your First Request
          </a>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Reusable Profile & Security Overview -->
<div class="row g-4">
  <div class="col-lg-6">
    <div class="card card-custom p-4 h-100 border-0 shadow-sm">
      <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill mb-2">
            CIT-APM-03 &bull; Profile Reuse
          </span>
          <h4 class="fw-bold mb-1">Reusable Resident Identity</h4>
          <p class="text-muted small mb-0">Pre-saved resident data automatically autofills your requests.</p>
        </div>
        <div class="avatar-circle bg-success text-white" style="width: 44px; height: 44px;">
          <i class="bi bi-arrow-repeat"></i>
        </div>
      </div>

      <div class="p-3 bg-light rounded-3 mb-3">
        <div class="row g-2 small">
          <div class="col-sm-6">
            <span class="text-muted d-block">Formal Name:</span>
            <strong class="text-dark"><%= reusableInfo.reusableData.fullName %></strong>
          </div>
          <div class="col-sm-6">
            <span class="text-muted d-block">Contact Phone:</span>
            <strong class="text-dark"><%= reusableInfo.reusableData.contactNumber || 'Not specified' %></strong>
          </div>
          <div class="col-12 mt-2 pt-2 border-top">
            <span class="text-muted d-block">Registered Address:</span>
            <strong class="text-dark"><%= reusableInfo.reusableData.completeAddress || 'Profile incomplete' %></strong>
          </div>
        </div>
      </div>

      <div class="d-flex align-items-center justify-content-between mt-auto">
        <a href="/citizen/profile" class="btn btn-sm btn-primary rounded-pill px-3">
          <i class="bi bi-pencil-square me-1"></i> Edit Profile (CIT-APM-02)
        </a>
        <a href="/citizen/profile/reuse" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill">
          <i class="bi bi-code-slash me-1"></i> JSON Endpoint
        </a>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card card-custom p-4 h-100 border-0 shadow-sm">
      <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
          <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-1 rounded-pill mb-2">
            CIT-RHV-02 &bull; QR Verification
          </span>
          <h4 class="fw-bold mb-1">Document Authenticity Checking</h4>
          <p class="text-muted small mb-0">Verify any official barangay clearance or certificate instantly.</p>
        </div>
        <div class="avatar-circle bg-warning text-dark" style="width: 44px; height: 44px;">
          <i class="bi bi-qr-code fs-4"></i>
        </div>
      </div>

      <p class="small text-muted mb-3">
        All certificates issued through QuickFile contain a unique QR verification code. Anyone, including employers, embassies, and universities, can verify authenticity in real-time.
      </p>

      <form action="/verify" method="GET" class="mt-auto">
        <div class="input-group">
          <input type="text" name="code" class="form-control" placeholder="Enter Verification / Tracking Code" required>
          <button type="submit" class="btn btn-warning fw-semibold px-3">
            <i class="bi bi-search me-1"></i> Verify
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
