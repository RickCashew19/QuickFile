<%- include('../layouts/header', { title: 'Citizen Login (CIT-IAM-02) - QuickFile' }) %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card card-custom p-4 p-md-5">
      <div class="text-center mb-4">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-2">
          CIT-IAM-02 &bull; User Login
        </span>
        <h2 class="fw-bold">Citizen Login</h2>
        <p class="text-muted small">Sign in to your QuickFile resident account.</p>
      </div>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="bi bi-exclamation-circle-fill me-2"></i> <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (typeof appSettings !== 'undefined' && appSettings && appSettings.googleAuthEnabled) { %>
        <div class="mb-3">
          <a href="/citizen/auth/google" class="btn btn-outline-danger w-100 py-2 rounded-pill fw-semibold d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-google"></i>
            <span>Continue with Google</span>
          </a>
        </div>
        <div class="position-relative text-center my-3">
          <hr class="text-muted opacity-25">
          <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 small text-muted text-uppercase fw-semibold" style="letter-spacing: 0.5px;">
            or manual sign in
          </span>
        </div>
      <% } else { %>
        <div class="alert alert-light border py-2 px-3 small text-muted mb-3 d-flex align-items-center gap-2 rounded-3">
          <i class="bi bi-info-circle text-primary"></i>
          <span>Manual Sign-In Active: Enter email & password below.</span>
        </div>
      <% } %>

      <form action="/citizen/login" method="POST">
        <div class="mb-3">
          <label class="form-label fw-semibold">Email Address</label>
          <input type="email" name="email" class="form-control" placeholder="citizen@quickfile.gov.ph" required value="<%= typeof email !== 'undefined' ? email || '' : '' %>">
        </div>

        <div class="mb-3">
          <div class="d-flex justify-content-between">
            <label class="form-label fw-semibold">Password</label>
            <a href="/citizen/forgot-password" class="small text-decoration-none">Forgot Password? (CIT-IAM-04)</a>
          </div>
          <input type="password" name="password" class="form-control" placeholder="••••••••" required>
        </div>

                <% if (typeof appSettings !== 'undefined' && appSettings && appSettings.recaptchaEnabled) { %>
          <div class="mb-3 d-flex justify-content-center">
            <script src="https://www.google.com/recaptcha/api.js" async defer></script>
            <div class="g-recaptcha" data-sitekey="<%= appSettings.activeRecaptcha.siteKey %>"></div>
          </div>
        <% } %>
        <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold">
          <i class="bi bi-box-arrow-in-right me-1"></i> Log In
        </button>
      </form>

      <div class="text-center mt-4 pt-3 border-top">
        <span class="text-muted small">Don't have an account yet?</span>
        <a href="/citizen/register" class="text-decoration-none fw-semibold ms-1">Register now (CIT-IAM-01)</a>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

