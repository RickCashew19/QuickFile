<%- include('../layouts/header', { title: 'Notifications - QuickFile' }) %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-1">
          CIT-RST-02 &bull; Notifications
        </span>
        <h2 class="fw-bold mb-0">My Notifications</h2>
      </div>
      <div class="d-flex gap-2">
        <% if (notifications && notifications.length > 0) { %>
          <form action="/citizen/notifications/clear" method="POST" onsubmit="return confirm('Clear all notifications?');">
            <button type="submit" class="btn btn-outline-danger rounded-pill btn-sm">
              <i class="bi bi-trash me-1"></i> Clear All
            </button>
          </form>
        <% } %>
        <a href="/citizen/dashboard" class="btn btn-outline-secondary rounded-pill btn-sm">
          <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
      </div>
    </div>

    <div class="card card-custom p-4 border-0 shadow-sm">
      <% if (notifications && notifications.length > 0) { %>
        <div class="list-group list-group-flush">
          <% notifications.forEach(function(n) { %>
            <div class="list-group-item px-0 py-3 border-bottom">
              <div class="d-flex justify-content-between align-items-start gap-2">
                <div>
                  <h6 class="fw-bold mb-1 text-dark">
                    <i class="bi bi-bell-fill text-warning me-2"></i><%= n.title %>
                  </h6>
                  <p class="text-muted small mb-1"><%= n.message %></p>
                  <small class="text-secondary"><i class="bi bi-clock me-1 text-primary"></i><%= formatDateTime(n.created_at) %></small>
                </div>
                <div class="d-flex gap-1 flex-shrink-0">
                  <% if (n.link) { %>
                    <a href="<%= n.link %>" class="btn btn-sm btn-outline-primary rounded-pill">
                      View &rarr;
                    </a>
                  <% } %>
                  <form action="/citizen/notifications/<%= n.id %>/delete" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill" title="Delete notification">
                      <i class="bi bi-x-lg"></i>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="text-center py-5">
          <i class="bi bi-bell-slash fs-1 text-muted"></i>
          <h5 class="fw-bold mt-2">No notifications yet</h5>
          <p class="text-muted">You will receive real-time updates as barangay personnel process your requests.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

