<%- include('../layouts/header', { title: 'Password Recovery (CIT-IAM-04) - QuickFile' }) %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="card card-custom p-4 p-md-5">
      <div class="text-center mb-4">
        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1 rounded-pill mb-2">
          CIT-IAM-04 &bull; Password Recovery
        </span>
        <h2 class="fw-bold">Recover Password</h2>
        <p class="text-muted small">Enter your registered email address to receive password reset instructions.</p>
      </div>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success fade show" role="alert">
          <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
          <% if (typeof resetUrl !== 'undefined' && resetUrl) { %>
            <div class="mt-3 p-3 bg-white rounded border">
              <strong class="d-block small text-muted mb-1">Direct Reset Link (Demo / Local Testing):</strong>
              <a href="<%= resetUrl %>" class="btn btn-sm btn-outline-primary w-100">Click Here to Reset Password</a>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="bi bi-exclamation-circle-fill me-2"></i> <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <form action="/citizen/forgot-password" method="POST">
        <div class="mb-4">
          <label class="form-label fw-semibold">Registered Email Address</label>
          <input type="email" name="email" class="form-control" placeholder="citizen@quickfile.gov.ph" required>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold">
          <i class="bi bi-send-fill me-1"></i> Send Recovery Link
        </button>
      </form>

      <div class="text-center mt-4 pt-3 border-top">
        <a href="/citizen/login" class="text-decoration-none small">
          <i class="bi bi-arrow-left me-1"></i> Return to Citizen Login
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>

