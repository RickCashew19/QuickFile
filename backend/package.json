{
  "name": "quickfile-backend",
  "version": "1.0.0",
  "description": "QuickFile - Barangay Document Request & Management System REST API",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/helpers/seeder.js",
    "seed:demo": "node src/helpers/demoSeeder.js",
    "seed:demo:atlas": "node scripts/seedAtlasDemo.js",
    "test": "node tests/test_locking_concurrency_real.js",
    "test:concurrency": "node tests/test_locking_concurrency_real.js",
    "test:google": "node tests/test_google_auth_audit.js",
    "test:phase1": "node tests/test_phase1_real.js",
    "test:api-keys": "node tests/test_api_key_management.js",
    "atlas:backup": "node scripts/backupAtlas.js",
    "atlas:provision": "node scripts/provisionAtlas.js",
    "atlas:provision:apply": "node scripts/provisionAtlas.js --apply",
    "atlas:provision:prune": "node scripts/provisionAtlas.js --apply --prune-redundant",
    "atlas:normalize": "node scripts/normalizeAtlas.js",
    "atlas:normalize:apply": "node scripts/normalizeAtlas.js --apply",
    "atlas:smoke": "node scripts/smokeAtlas.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "9.15.3",
    "docxtemplater": "3.71.1",
    "dotenv": "^16.4.7",
    "exceljs": "4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "10.4.0",
    "pdfmake": "0.3.13",
    "pizzip": "3.3.0",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "fast-xml-parser": "5.12.0",
    "pdf-parse": "2.4.5"
  }
}
