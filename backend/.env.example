# ==============================================================================
# QuickFile Backend Environment Configuration (.env.example)
# Copy this file to .env and configure for your environment.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/quickfile

# JWT Authentication
JWT_SECRET=quickfile_jwt_development_secret_key_replace_in_production_32chars
JWT_EXPIRES_IN=7d

# Frontend URL (Used for CORS allowlist and Password Reset links)
FRONTEND_URL=http://localhost:5173

# Super Admin Key (Verified via crypto.timingSafeEqual on sensitive setting updates)
# Must be set. Server and seeder will fail to start if this key is missing.
SU_ADMIN_KEY=change_me_super_admin_key

# Jurisdiction Information
BARANGAY_NAME=Barangay 11
CITY_MUNICIPALITY=Malaybalay
PROVINCE=Bukidnon

# Seed Default Account Passwords (Read strictly from .env)
DEFAULT_ADMIN_EMAIL=admin@quickfile.gov.ph
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_STAFF_EMAIL=staff@quickfile.gov.ph
DEFAULT_STAFF_PASSWORD=Staff@123456
DEFAULT_CITIZEN_EMAIL=citizen@quickfile.gov.ph
DEFAULT_CITIZEN_PASSWORD=Citizen@123456

# ==============================================================================
# Integration Settings (Default & Custom slots)
# The application uses CUSTOM_* if provided, otherwise falls back to DEFAULT_*
# ==============================================================================

# 1. Google OAuth
DEFAULT_GOOGLE_CLIENT_ID=
DEFAULT_GOOGLE_CLIENT_SECRET=
CUSTOM_GOOGLE_CLIENT_ID=
CUSTOM_GOOGLE_CLIENT_SECRET=

# 2. PhilSMS Gateway
DEFAULT_SMS_GATEWAY_URL=https://dashboard.philsms.com/api/v3/
DEFAULT_SMS_API_TOKEN=
CUSTOM_SMS_GATEWAY_URL=
CUSTOM_SMS_API_TOKEN=
CUSTOM_SMS_SENDER_ID=

# 3. SMTP / Email Notifications
DEFAULT_SMTP_HOST=smtp.gmail.com
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_SECURE=false
DEFAULT_SMTP_USER=
DEFAULT_SMTP_PASS=
DEFAULT_SMTP_FROM_NAME=QuickFile Barangay Portal
DEFAULT_SMTP_FROM_EMAIL=
CUSTOM_SMTP_HOST=
CUSTOM_SMTP_PORT=
CUSTOM_SMTP_SECURE=
CUSTOM_SMTP_USER=
CUSTOM_SMTP_PASS=
CUSTOM_SMTP_FROM_NAME=
CUSTOM_SMTP_FROM_EMAIL=

# 4. Google reCAPTCHA v2
DEFAULT_RECAPTCHA_SITE_KEY=
DEFAULT_RECAPTCHA_SECRET_KEY=
CUSTOM_RECAPTCHA_SITE_KEY=
CUSTOM_RECAPTCHA_SECRET_KEY=

# 5. External REST API Gateway
DEFAULT_REST_API_SECRET_KEY=quickfile_default_external_api_key_2026
CUSTOM_REST_API_SECRET_KEY=
